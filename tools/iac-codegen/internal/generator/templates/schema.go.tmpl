{{define "setItemHelpers" -}}
// setItemConfig returns the configuration value of the attribute on the path p, which is inside a
// set item. The framework gives the modifier the configuration of the item at the same index, which
// can be another item: the configuration and the plan sort their items apart. The set step of p
// holds the planned item, so the walk takes a configured item that the planned item matches. ok is
// false when the configuration leaves out the set, directly or with an object that holds it: the
// set comes from the API or another attribute, so a null value of one of its items is no removal.
// It is also false when no configured item matches.
func setItemConfig(ctx context.Context, config tftypes.Value, p path.Path) (value tftypes.Value, ok bool) {
	return configAt(ctx, config, p.Steps(), false)
}

func configAt(ctx context.Context, v tftypes.Value, steps path.PathSteps, inSet bool) (tftypes.Value, bool) {
	if len(steps) == 0 || !v.IsKnown() || v.IsNull() {
		return v, inSet || len(steps) == 0
	}
	switch step := steps[0].(type) {
	case path.PathStepAttributeName:
		var attrs map[string]tftypes.Value
		if v.As(&attrs) != nil {
			return v, false
		}
		next, found := attrs[string(step)]
		return configAt(ctx, next, steps[1:], inSet && found)
	case path.PathStepElementKeyString:
		var elems map[string]tftypes.Value
		if v.As(&elems) != nil {
			return v, false
		}
		next, found := elems[string(step)]
		if !found {
			return tftypes.NewValue(v.Type().(tftypes.Map).ElementType, nil), inSet
		}
		return configAt(ctx, next, steps[1:], inSet)
	case path.PathStepElementKeyInt:
		var elems []tftypes.Value
		if v.As(&elems) != nil || int(step) < 0 || int(step) >= len(elems) {
			return v, false
		}
		return configAt(ctx, elems[step], steps[1:], inSet)
	case path.PathStepElementKeyValue:
		planned, err := step.Value.ToTerraformValue(ctx)
		var elems []tftypes.Value
		if err != nil || v.As(&elems) != nil {
			return v, false
		}
		// A planned value that equals a configured value comes from that item, so a match that
		// configures the attribute wins over one that leaves it out.
		var value tftypes.Value
		ok := false
		for _, elem := range elems {
			if !configMatches(elem, planned) {
				continue
			}
			if next, found := configAt(ctx, elem, steps[1:], true); found && (!ok || value.IsNull()) {
				value, ok = next, true
			}
		}
		return value, ok
	}
	return v, false
}

// configMatches reports whether the planned value can come from the configured one: every value
// that the configuration sets is the planned one. A null or unknown configured value matches any
// plan, because a computed attribute fills it in.
func configMatches(config, plan tftypes.Value) bool {
	if !config.IsKnown() || config.IsNull() || !plan.IsKnown() {
		return true
	}
	if plan.IsNull() {
		return false
	}
	switch config.Type().(type) {
	case tftypes.Object, tftypes.Map:
		var c, p map[string]tftypes.Value
		if config.As(&c) != nil || plan.As(&p) != nil {
			return false
		}
		for k, cv := range c {
			pv, found := p[k]
			if !found || !configMatches(cv, pv) {
				return false
			}
		}
		return true
	case tftypes.List, tftypes.Tuple:
		var c, p []tftypes.Value
		if config.As(&c) != nil || plan.As(&p) != nil || len(c) != len(p) {
			return false
		}
		for i := range c {
			if !configMatches(c[i], p[i]) {
				return false
			}
		}
		return true
	case tftypes.Set:
		var c, p []tftypes.Value
		if config.As(&c) != nil || plan.As(&p) != nil || len(c) != len(p) {
			return false
		}
		for _, cv := range c {
			if !slices.ContainsFunc(p, func(pv tftypes.Value) bool { return configMatches(cv, pv) }) {
				return false
			}
		}
		return true
	}
	return config.Equal(plan)
}

{{end}}

{{- if .HasTypedArms}}

// typedInferArm is an arm of a typedArms object whose type can be left out, with the fields that it has.
type typedInferArm struct {
	Value  string
	Fields []string
}

// inferTypedKind returns the type for an omitted type attribute: the first arm that has a field
// that is set (a collection is set when it is not empty), and else the arm without fields. unknown
// is true when a field of an arm is unknown, because the type then depends on it.
func inferTypedKind(arms []typedInferArm, fields map[string]attr.Value) (kind string, unknown bool) {
	fallback := ""
	for _, arm := range arms {
		if len(arm.Fields) == 0 {
			if fallback == "" {
				fallback = arm.Value
			}
			continue
		}
		for _, name := range arm.Fields {
			v := fields[name]
			if v == nil || v.IsNull() {
				continue
			}
			if v.IsUnknown() {
				return "", true
			}
			if !typedCollectionEmpty(v) {
				return arm.Value, false
			}
		}
	}
	return fallback, false
}

func typedCollectionEmpty(v attr.Value) bool {
	switch c := v.(type) {
	case types.List:
		return len(c.Elements()) == 0
	case types.Set:
		return len(c.Elements()) == 0
	case types.Map:
		return len(c.Elements()) == 0
	}
	return false
}

// typedArmInferred plans the type of an omitted type attribute from the fields of the plan.
type typedArmInferred struct {
	Arms []typedInferArm
}

func (m typedArmInferred) Description(context.Context) string {
	return "When the type is omitted, it is the first arm that has a field that is set, and else the arm without fields."
}

func (m typedArmInferred) MarkdownDescription(ctx context.Context) string {
	return m.Description(ctx)
}

func (m typedArmInferred) PlanModifyString(ctx context.Context, req planmodifier.StringRequest, resp *planmodifier.StringResponse) {
	if req.ConfigValue.IsUnknown() || !req.ConfigValue.IsNull() {
		return
	}
	fields := map[string]attr.Value{}
	for _, arm := range m.Arms {
		for _, name := range arm.Fields {
			var v attr.Value
			if diags := req.Plan.GetAttribute(ctx, req.Path.ParentPath().AtName(name), &v); diags.HasError() {
				resp.Diagnostics.Append(diags...)
				return
			}
			fields[name] = v
		}
	}
	kind, unknown := inferTypedKind(m.Arms, fields)
	switch {
	case unknown:
		resp.PlanValue = types.StringUnknown()
	case kind != "":
		resp.PlanValue = types.StringValue(kind)
	}
}

// typedArmValidator checks an object that shows a oneOf as a type attribute and the merged fields
// of its arms. It runs on the type attribute. A field that the arm named by the type does not have
// must be unset, a field that the arm needs must be set, and the checks of a scalar arm run on the
// value that the arm holds.
type typedArmValidator struct {
	// Names are the merged attributes, in schema order.
	Names []string
	// Fields are the attributes that each arm has, by value of the type.
	Fields map[string][]string
	// Required are the attributes that an arm needs, by value of the type: the value of a scalar
	// arm, and the fields that the arm requires. The attributes are optional because other arms
	// do not have them.
	Required map[string][]string
	// Values are the checks of a scalar arm, by value of the type and attribute.
	Values map[string]map[string][]validator.String
	// Rules are the rules over attributes of an arm, by value of the type.
	Rules map[string][]typedRule
}

// typedRule is a rule over attributes of an arm: exactlyOneOf, atLeastOneOf, alsoRequires, or
// conflictsWith. Names has the attribute that the line is on first, then the others.
type typedRule struct {
	Kind  string
	Names []string
}

func (v typedArmValidator) Description(context.Context) string {
	return "A field that the chosen type does not have must be unset."
}

func (v typedArmValidator) MarkdownDescription(ctx context.Context) string {
	return v.Description(ctx)
}

// validateRules checks the rules of the arm that the type names. A value that is unknown makes the
// rule wait until it is known.
func (v typedArmValidator) validateRules(ctx context.Context, req validator.StringRequest, resp *validator.StringResponse, kind string) {
	for _, rule := range v.Rules[kind] {
		set, unknown := 0, false
		first := false
		for i, name := range rule.Names {
			var value attr.Value
			if diags := req.Config.GetAttribute(ctx, req.Path.ParentPath().AtName(name), &value); diags.HasError() {
				resp.Diagnostics.Append(diags...)
				return
			}
			switch {
			case value != nil && value.IsUnknown():
				unknown = true
			case value != nil && !value.IsNull() && !typedCollectionEmpty(value):
				set++
				first = first || i == 0
			}
		}
		if unknown {
			continue
		}
		at := req.Path.ParentPath().AtName(rule.Names[0])
		list := strings.Join(rule.Names, ", ")
		switch {
		case rule.Kind == "exactlyOneOf" && set != 1:
			resp.Diagnostics.AddAttributeError(at, "Invalid attribute combination", fmt.Sprintf("When the type is %q, exactly one of %s must be set.", kind, list))
		case rule.Kind == "atLeastOneOf" && set == 0:
			resp.Diagnostics.AddAttributeError(at, "Missing required attribute", fmt.Sprintf("When the type is %q, at least one of %s must be set.", kind, list))
		case rule.Kind == "conflictsWith" && first && set > 1:
			resp.Diagnostics.AddAttributeError(at, "Invalid attribute combination", fmt.Sprintf("When the type is %q, %s must not be set with the others of %s.", kind, rule.Names[0], list))
		case rule.Kind == "alsoRequires" && first && set != len(rule.Names):
			resp.Diagnostics.AddAttributeError(at, "Missing required attribute", fmt.Sprintf("When the type is %q and %s is set, all of %s must be set.", kind, rule.Names[0], list))
		}
	}
}

func (v typedArmValidator) ValidateString(ctx context.Context, req validator.StringRequest, resp *validator.StringResponse) {
	if req.ConfigValue.IsNull() || req.ConfigValue.IsUnknown() {
		return
	}
	kind := req.ConfigValue.ValueString()
	allowed, ok := v.Fields[kind]
	if !ok {
		return // the OneOf validator of the type reports it
	}
	v.validateRules(ctx, req, resp, kind)
	for _, name := range v.Required[kind] {
		at := req.Path.ParentPath().AtName(name)
		var value attr.Value
		if diags := req.Config.GetAttribute(ctx, at, &value); diags.HasError() {
			resp.Diagnostics.Append(diags...)
			continue
		}
		// An unknown value is checked when it is known.
		if value == nil || value.IsNull() {
			resp.Diagnostics.AddAttributeError(at, "Missing required attribute", fmt.Sprintf("When the type is %q, %s must be set.", kind, name))
		}
	}
	for _, name := range v.Names {
		at := req.Path.ParentPath().AtName(name)
		var value attr.Value
		if diags := req.Config.GetAttribute(ctx, at, &value); diags.HasError() {
			resp.Diagnostics.Append(diags...)
			continue
		}
		if value == nil || value.IsNull() || value.IsUnknown() || typedCollectionEmpty(value) {
			continue // an empty collection is no value: it is what the default and the API give
		}
		if !slices.Contains(allowed, name) {
			resp.Diagnostics.AddAttributeError(at, "Invalid attribute combination", fmt.Sprintf("When the type is %q, %s must not be set.", kind, name))
			continue
		}
		text, isText := value.(types.String)
		for _, check := range v.Values[kind][name] {
			if !isText {
				continue
			}
			out := &validator.StringResponse{}
			check.ValidateString(ctx, validator.StringRequest{Path: at, PathExpression: at.Expression(), Config: req.Config, ConfigValue: text}, out)
			resp.Diagnostics.Append(out.Diagnostics...)
		}
	}
}
{{- end}}
