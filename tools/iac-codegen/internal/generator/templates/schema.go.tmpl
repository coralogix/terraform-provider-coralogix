{{- range .ConfigValidators}}
		{{.}},
{{- end}}
	}
}

{{- if .RequestReplaceKinds}}

// requestReplaceModifier replaces the resource when a value that Create sends
// changes. It compares the values without the attributes that the server sets
// (requestValue). When the resource changes, Terraform plans those attributes
// as unknown, so a comparison of whole values would replace the resource on
// every change.
type requestReplaceModifier struct{ at string }

func (m requestReplaceModifier) Description(context.Context) string {
	return "Replaces the resource when a value that Create sends changes."
}

func (m requestReplaceModifier) MarkdownDescription(ctx context.Context) string {
	return m.Description(ctx)
}

// changed reports whether the request values of plan and state differ. Create
// and destroy replace nothing.
func (m requestReplaceModifier) changed(ctx context.Context, create, destroy bool, plan, state attr.Value, diags *diag.Diagnostics) bool {
	if create || destroy {
		return false
	}
	return !requestValue(ctx, m.at, plan, diags).Equal(requestValue(ctx, m.at, state, diags))
}
{{range .RequestReplaceKinds}}
func (m requestReplaceModifier) PlanModify{{.}}(ctx context.Context, req planmodifier.{{.}}Request, resp *planmodifier.{{.}}Response) {
	resp.RequiresReplace = m.changed(ctx, req.State.Raw.IsNull(), req.Plan.Raw.IsNull(), req.PlanValue, req.StateValue, &resp.Diagnostics)
}
{{end}}
{{- end}}

{{- if .HasServerDefaults}}
// serverDefaultModifier distinguishes removal from a steady server default.
// It never inserts the default into configuration or an API request. When a
// user removes a different value, it makes the plan unknown. Update then sends
// the field in the update mask without a body value, and the API resets it.
{{- if .SetServerDefaults}}
// fromPlan reads the prior value from the plan, for an attribute inside a set
// item: the framework gives it the state of the item at the same index, and
// Terraform proposes the value of the prior item that it paired with the item.
type serverDefaultModifier struct {
	value    attr.Value
	fromPlan bool
}
{{- else}}
type serverDefaultModifier struct{ value attr.Value }
{{- end}}

func (m serverDefaultModifier) Description(context.Context) string {
	return "Resets a removed value to the server default."
}

func (m serverDefaultModifier) MarkdownDescription(ctx context.Context) string {
	return m.Description(ctx)
}

{{if .SetServerDefaults -}}
// setItemConfig returns the configuration value of the attribute on the path p, which is inside a
// set item. The framework gives the modifier the configuration of the item at the same index, which
// can be another item: the configuration and the plan sort their items apart. The set step of p
// holds the planned item, so the walk takes a configured item that the planned item matches. ok is
// false when the configuration leaves out the set, directly or with an object that holds it: the
// set comes from the API or another attribute, so a null value of one of its items is no removal.
// It is also false when no configured item matches.
func setItemConfig(ctx context.Context, config tftypes.Value, p path.Path) (value tftypes.Value, ok bool) {
	return configAt(ctx, config, p.Steps(), false)
}

func configAt(ctx context.Context, v tftypes.Value, steps path.PathSteps, inSet bool) (tftypes.Value, bool) {
	if len(steps) == 0 || !v.IsKnown() || v.IsNull() {
		return v, inSet || len(steps) == 0
	}
	switch step := steps[0].(type) {
	case path.PathStepAttributeName:
		var attrs map[string]tftypes.Value
		if v.As(&attrs) != nil {
			return v, false
		}
		next, found := attrs[string(step)]
		return configAt(ctx, next, steps[1:], inSet && found)
	case path.PathStepElementKeyString:
		var elems map[string]tftypes.Value
		if v.As(&elems) != nil {
			return v, false
		}
		next, found := elems[string(step)]
		if !found {
			return tftypes.NewValue(v.Type().(tftypes.Map).ElementType, nil), inSet
		}
		return configAt(ctx, next, steps[1:], inSet)
	case path.PathStepElementKeyInt:
		var elems []tftypes.Value
		if v.As(&elems) != nil || int(step) < 0 || int(step) >= len(elems) {
			return v, false
		}
		return configAt(ctx, elems[step], steps[1:], inSet)
	case path.PathStepElementKeyValue:
		planned, err := step.Value.ToTerraformValue(ctx)
		var elems []tftypes.Value
		if err != nil || v.As(&elems) != nil {
			return v, false
		}
		// A planned value that equals a configured value comes from that item, so a match that
		// configures the attribute wins over one that leaves it out.
		var value tftypes.Value
		ok := false
		for _, elem := range elems {
			if !configMatches(elem, planned) {
				continue
			}
			if next, found := configAt(ctx, elem, steps[1:], true); found && (!ok || value.IsNull()) {
				value, ok = next, true
			}
		}
		return value, ok
	}
	return v, false
}

// configMatches reports whether the planned value can come from the configured one: every value
// that the configuration sets is the planned one. A null or unknown configured value matches any
// plan, because a computed attribute fills it in.
func configMatches(config, plan tftypes.Value) bool {
	if !config.IsKnown() || config.IsNull() || !plan.IsKnown() {
		return true
	}
	if plan.IsNull() {
		return false
	}
	switch config.Type().(type) {
	case tftypes.Object, tftypes.Map:
		var c, p map[string]tftypes.Value
		if config.As(&c) != nil || plan.As(&p) != nil {
			return false
		}
		for k, cv := range c {
			pv, found := p[k]
			if !found || !configMatches(cv, pv) {
				return false
			}
		}
		return true
	case tftypes.List, tftypes.Tuple:
		var c, p []tftypes.Value
		if config.As(&c) != nil || plan.As(&p) != nil || len(c) != len(p) {
			return false
		}
		for i := range c {
			if !configMatches(c[i], p[i]) {
				return false
			}
		}
		return true
	case tftypes.Set:
		var c, p []tftypes.Value
		if config.As(&c) != nil || plan.As(&p) != nil || len(c) != len(p) {
			return false
		}
		for _, cv := range c {
			if !slices.ContainsFunc(p, func(pv tftypes.Value) bool { return configMatches(cv, pv) }) {
				return false
			}
		}
		return true
	}
	return config.Equal(plan)
}

{{end -}}
func serverDefaultPlan(config, state, declared attr.Value) (unknown, preserve bool) {
	if config.IsUnknown() || !config.IsNull() || state.IsNull() || state.IsUnknown() {
		return false, false
	}
	if state.Equal(declared) {
		return false, true
	}
	return true, false
}

{{range .ServerDefaultKinds}}
func (m serverDefaultModifier) PlanModify{{.}}({{if $.SetServerDefaults}}ctx{{else}}_{{end}} context.Context, req planmodifier.{{.}}Request, resp *planmodifier.{{.}}Response) {
	if req.Plan.Raw.IsNull() {
		return
	}
{{- if $.SetServerDefaults}}
	config, prior := attr.Value(req.ConfigValue), attr.Value(req.StateValue)
	if m.fromPlan {
		value, ok := setItemConfig(ctx, req.Config.Raw, req.Path)
		if !ok || !value.IsNull() {
			return
		}
		config, prior = types.{{.}}Null(), req.PlanValue
	}
	unknown, preserve := serverDefaultPlan(config, prior, m.value)
	if unknown {
		resp.PlanValue = types.{{.}}Unknown()
	} else if preserve {
		resp.PlanValue = prior.(types.{{.}})
	}
{{- else}}
	unknown, preserve := serverDefaultPlan(req.ConfigValue, req.StateValue, m.value)
	if unknown {
		resp.PlanValue = types.{{.}}Unknown()
	} else if preserve {
		resp.PlanValue = req.StateValue
	}
{{- end}}
}
{{end}}
{{- end}}

