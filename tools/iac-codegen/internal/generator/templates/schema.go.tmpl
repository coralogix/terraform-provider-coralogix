// Schema is the Terraform schema of the resource.
func Schema() schema.Schema {
	return schema.Schema{
{{- if .SchemaVersion}}
		Version: {{.SchemaVersion}},
{{- end}}
		Attributes: map[string]schema.Attribute{
{{- range .Attributes}}
			{{printf "%q" .Name}}: {{template "attribute" .}},
{{- end}}
		},
{{- if .ResourceMarkdownDescription}}
		MarkdownDescription: {{printf "%q" .ResourceMarkdownDescription}},
{{- end}}
	}
}

// ConfigValidators are the resource validators.
func ConfigValidators() []resource.ConfigValidator {
	return []resource.ConfigValidator{
{{- range .ConfigValidators}}
		{{.}},
{{- end}}
	}
}

{{- if .RequestReplaceKinds}}

// requestReplaceModifier replaces the resource when a value that Create sends
// changes. It compares the values without the attributes that the server sets
// (requestValue). When the resource changes, Terraform plans those attributes
// as unknown, so a comparison of whole values would replace the resource on
// every change.
type requestReplaceModifier struct{ at string }

func (m requestReplaceModifier) Description(context.Context) string {
	return "Replaces the resource when a value that Create sends changes."
}

func (m requestReplaceModifier) MarkdownDescription(ctx context.Context) string {
	return m.Description(ctx)
}

// changed reports whether the request values of plan and state differ. Create
// and destroy replace nothing.
func (m requestReplaceModifier) changed(ctx context.Context, create, destroy bool, plan, state attr.Value, diags *diag.Diagnostics) bool {
	if create || destroy {
		return false
	}
	return !requestValue(ctx, m.at, plan, diags).Equal(requestValue(ctx, m.at, state, diags))
}
{{range .RequestReplaceKinds}}
func (m requestReplaceModifier) PlanModify{{.}}(ctx context.Context, req planmodifier.{{.}}Request, resp *planmodifier.{{.}}Response) {
	resp.RequiresReplace = m.changed(ctx, req.State.Raw.IsNull(), req.Plan.Raw.IsNull(), req.PlanValue, req.StateValue, &resp.Diagnostics)
}
{{end}}
{{- end}}

{{- if .HasServerDefaults}}
// serverDefaultModifier distinguishes removal from a steady server default.
// It never inserts the default into configuration or an API request. When a
// user removes a different value, it makes the plan unknown. Update then sends
// the field in the update mask without a body value, and the API resets it.
{{- if .SetServerDefaults}}
// fromPlan reads the prior value from the plan, for an attribute inside a set
// item: the framework gives it the state of the item at the same index, and
// Terraform proposes the value of the prior item that it paired with the item.
type serverDefaultModifier struct {
	value    attr.Value
	fromPlan bool
}
{{- else}}
type serverDefaultModifier struct{ value attr.Value }
{{- end}}

func (m serverDefaultModifier) Description(context.Context) string {
	return "Resets a removed value to the server default."
}

func (m serverDefaultModifier) MarkdownDescription(ctx context.Context) string {
	return m.Description(ctx)
}

{{if .SetServerDefaults -}}
// rootConfigured reports whether the configuration sets the top-level attribute that holds p. A set
// that the configuration leaves out comes from the API or another attribute, so a null value of
// one of its items is not a removal.
func rootConfigured(ctx context.Context, config tfsdk.Config, p path.Path) bool {
	steps := p.Steps()
	if len(steps) == 0 {
		return true
	}
	name, ok := steps[0].(path.PathStepAttributeName)
	if !ok {
		return true
	}
	var v attr.Value
	if config.GetAttribute(ctx, path.Root(string(name)), &v).HasError() || v == nil {
		return true
	}
	return !v.IsNull()
}

{{end -}}
func serverDefaultPlan(config, state, declared attr.Value) (unknown, preserve bool) {
	if config.IsUnknown() || !config.IsNull() || state.IsNull() || state.IsUnknown() {
		return false, false
	}
	if state.Equal(declared) {
		return false, true
	}
	return true, false
}

{{range .ServerDefaultKinds}}
func (m serverDefaultModifier) PlanModify{{.}}({{if $.SetServerDefaults}}ctx{{else}}_{{end}} context.Context, req planmodifier.{{.}}Request, resp *planmodifier.{{.}}Response) {
	if req.Plan.Raw.IsNull() {
		return
	}
{{- if $.SetServerDefaults}}
	if m.fromPlan && !rootConfigured(ctx, req.Config, req.Path) {
		return
	}
	prior := req.StateValue
	if m.fromPlan {
		prior = req.PlanValue
	}
	unknown, preserve := serverDefaultPlan(req.ConfigValue, prior, m.value)
	if unknown {
		resp.PlanValue = types.{{.}}Unknown()
	} else if preserve {
		resp.PlanValue = prior
	}
{{- else}}
	unknown, preserve := serverDefaultPlan(req.ConfigValue, req.StateValue, m.value)
	if unknown {
		resp.PlanValue = types.{{.}}Unknown()
	} else if preserve {
		resp.PlanValue = req.StateValue
	}
{{- end}}
}
{{end}}
{{- end}}

{{define "attribute" -}}
schema.{{.Kind}}Attribute{
{{- if .Required}}
	Required: true,
{{- end}}
{{- if .Optional}}
	Optional: true,
{{- end}}
{{- if .WriteOnly}}
	WriteOnly: true,
{{- end}}
{{- if .Computed}}
	Computed: true,
{{- end}}
{{- if .CustomType}}
	CustomType: {{.CustomType}},
{{- end}}
{{- if .ElementType}}
	ElementType: {{.ElementType}},
{{- end}}
{{- if .Default}}
	Default: {{.Default}},
{{- end}}
{{- if .DeprecationMessage}}
	DeprecationMessage: {{printf "%q" .DeprecationMessage}},
{{- end}}
{{- if .Validators}}
	Validators: []validator.{{.ValueKind}}{
	{{- range .Validators}}
		{{.}},
	{{- end}}
	},
{{- end}}
{{- if .Modifiers}}
	PlanModifiers: []planmodifier.{{.ValueKind}}{
	{{- range .Modifiers}}
		{{.}},
	{{- end}}
	},
{{- end}}
{{- if eq .Kind "SingleNested"}}
	Attributes: {{template "attributes" .Attributes}},
{{- else if or (eq .Kind "ListNested") (eq .Kind "SetNested") (eq .Kind "MapNested")}}
	NestedObject: schema.NestedAttributeObject{
		Attributes: {{template "attributes" .Attributes}},
	},
{{- end}}
	{{if .PlainDescription}}Description{{else}}MarkdownDescription{{end}}: {{printf "%q" .Description}},
}
{{- end}}

{{define "attributes" -}}
map[string]schema.Attribute{
{{- range .}}
	{{printf "%q" .Name}}: {{template "attribute" .}},
{{- end}}
}
{{- end}}
