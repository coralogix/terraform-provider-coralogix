// resourceWithID returns a resource that holds only id.
func resourceWithID(id {{.IDGoType}}) *{{$sdk}}.{{.Resource}} {
	v := &{{$sdk}}.{{.Resource}}{}
	setAPIID(v, id)
	return v
}
