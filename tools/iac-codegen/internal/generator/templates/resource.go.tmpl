{{if .Existing -}}
// setState writes the resource in an API response to the state. A value that is empty in both
// the response and prior keeps its form from prior: the plan after Create or Update, or the
// state before Read. A state upgrade has no prior of this schema version, so it passes nil and
// the state takes the value of the API. flatten returns an error when the response has no
// resource.
{{- else -}}
// setState writes the resource in an API response to the state. A value that
// is empty in both the response and prior keeps its form from prior: the plan
// after Create or Update, or the state before Read. flatten
// returns an error when the response has no resource.
{{- end}}
func (r *Resource) setState(ctx context.Context, v *{{$sdk}}.{{.Resource}}, prior tfData, state *tfsdk.State) diag.Diagnostics {
	var diags diag.Diagnostics
{{- if .Existing}}
	if r.hooks.BeforeFlatten != nil && v != nil {
		diags.Append(r.hooks.BeforeFlatten(ctx, v)...)
		if diags.HasError() {
			return diags
		}
	}
{{- end}}
	m, flattenDiags := flatten(ctx, v{{if $.Conv.HasPrior}}, priorModel(ctx, prior){{end}})
	diags.Append(flattenDiags...)
	if diags.HasError() {
		return diags
	}
{{- if and .Singleton .SingletonID}}
	if m.Id.IsNull() || m.Id.ValueString() == "" {
		m.Id = types.StringValue(TypeName) // the API returned no id
		if prior != nil {
			var id types.String
			if !prior.GetAttribute(ctx, path.Root("id"), &id).HasError() && !id.IsNull() && !id.IsUnknown() && id.ValueString() != "" {
				m.Id = id // keep the id that the plan or the state has
			}
		}
	}
{{- else if .Singleton}}
	m.Id = types.StringValue(SingletonID) // a singleton has a fixed id (D18)
{{- end}}
	diags.Append(state.Set(ctx, m)...)
	if diags.HasError() {
		return diags
	}
{{- if .Existing}}
	if prior != nil {
		diags.Append(keepPriorEmpty(ctx, prior, state)...)
	}
	if r.hooks.AfterRead != nil && !diags.HasError() {
		diags.Append(r.hooks.AfterRead(ctx, state, prior)...)
	}
{{- else}}
	diags.Append(keepPriorEmpty(ctx, prior, state)...)
{{- end}}
	return diags
}

