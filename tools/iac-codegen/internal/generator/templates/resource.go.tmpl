// absent reports whether a response has none of the arms that hold the resource. The API then
// has no resource: it returns another arm, or an empty one.
func absent(v *{{$sdk}}.{{.Resource}}) bool {
	return v == nil{{range .Arms}} || v.{{.}} == nil{{end}}
