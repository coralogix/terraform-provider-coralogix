func (r *Resource) Configure(_ context.Context, req resource.ConfigureRequest, resp *resource.ConfigureResponse) {
	if req.ProviderData == nil {
		return // The provider is not configured yet.
	}
	cs, ok := req.ProviderData.(*{{$provider}}.{{.ClientSet}})
	if !ok {
		resp.Diagnostics.AddError("Unexpected provider data",
			fmt.Sprintf("The provider data is %T. The resource needs *{{$provider}}.{{.ClientSet}}.", req.ProviderData))
		return
	}
	r.client = cs.{{.Accessor}}()
}

// ImportState sets the id. The Read after the import sets the other attributes.
func (r *Resource) ImportState(ctx context.Context, req resource.ImportStateRequest, resp *resource.ImportStateResponse) {
{{- if .IDBits}}
	id, err := strconv.ParseInt(req.ID, 10, {{.IDBits}})
	if err != nil {
		resp.Diagnostics.AddError("Invalid import ID", fmt.Sprintf("The import ID %q is not a valid {{.IDGoType}}.", req.ID))
		return
	}
	resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), {{.IDGoType}}(id))...)
{{- else}}
	resource.ImportStatePassthroughID(ctx, path.Root({{printf "%q" .IDAttr}}), req, resp)
{{- end}}
}

func (r *Resource) Create(ctx context.Context, req resource.CreateRequest, resp *resource.CreateResponse) {
	resp.Diagnostics.Append(validateCreate(ctx, req.Config, req.Plan)...)
	if resp.Diagnostics.HasError() {
		return
	}
	var plan {{.Model}}
	resp.Diagnostics.Append(req.Plan.Get(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}
	body, diags := expandCreate(ctx, &plan)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- if .Existing}}
	resp.Diagnostics.Append(r.beforeWrite(ctx, req.Config, body)...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- end}}
{{- if .UpdateOnly}}
	resp.Diagnostics.Append(validateUpdateOnly(ctx, req.Config, req.Plan)...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- end}}
	v, err := r.create(ctx, body)
	if err != nil {
		resp.Diagnostics.AddError("Unable to create "+TypeName, err.Error())
{{- if .Create.ResponseID}}
		if v != nil {
			// The resource exists, but reading it failed. Keep the id, so Terraform marks the
			// resource as tainted and can delete it.
			resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), {{if not .IDValue}}*{{end}}v.{{.IDField}})...)
		}
{{- end}}
		return
	}
	diags = r.setState(ctx, v, req.Plan, &resp.State)
	resp.Diagnostics.Append(diags...)
{{- if .UpdateOnly}}
	if !diags.HasError() {
		// The resource exists and the state is complete. An error here leaves
		// the state, so Terraform marks the resource as tainted.
		resp.Diagnostics.Append(r.applyUpdateOnly(ctx, req.Config, req.Plan, &resp.State)...)
	}
{{- end}}
{{- if .Singleton}}
	if diags.HasError() {
		// The singleton exists, but the state is not complete. Keep the id, so
		// Terraform marks the resource as tainted and can delete it.
		resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root("id"), SingletonID)...)
	}
{{- else}}
	if diags.HasError() && v != nil{{if not .IDValue}} && v.{{.IDField}} != nil{{end}} {
		// The resource exists, but the state is not complete. Keep the id, so
		// Terraform marks the resource as tainted and can delete it.
		resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), {{if not .IDValue}}*{{end}}v.{{.IDField}})...)
	}
{{- end}}
}

{{if .UpdateOnly -}}
// updateOnlyFields are the attributes that Create cannot send. Create stores
// their server default.
var updateOnlyFields = []struct {
	attr          string
	serverDefault attr.Value
}{
{{- range .UpdateOnly}}
	{attr: {{printf "%q" .Attr}}, serverDefault: {{.Default}}},
{{- end}}
}

// validateUpdateOnly stops Create before the API call when a configured
// attribute that only the follow-up Update sends is still unknown.
func validateUpdateOnly(ctx context.Context, config tfsdk.Config, plan tfsdk.Plan) diag.Diagnostics {
	var diags diag.Diagnostics
	for _, field := range updateOnlyFields {
		var c, p attr.Value
		diags.Append(config.GetAttribute(ctx, path.Root(field.attr), &c)...)
		diags.Append(plan.GetAttribute(ctx, path.Root(field.attr), &p)...)
		if diags.HasError() {
			return diags
		}
		validateRequestValue(path.Root(field.attr), c, p, true, &diags)
	}
	return diags
}

// applyUpdateOnly follows Create with an Update when the configuration sets an
// attribute that Create cannot send to another value than the one Create
// stored, or omits it and Create stored another value than the server default.
// The Update body is the created resource with the configured values, and
// without the omitted ones, so the server stores their default.
func (r *Resource) applyUpdateOnly(ctx context.Context, config tfsdk.Config, plan tfsdk.Plan, state *tfsdk.State) diag.Diagnostics {
	next, differs, diags := updateOnlyState(ctx, config, plan, state)
	if !differs || diags.HasError() {
		return diags
	}
{{- if or (not .UpdateIDInBody) .UpdateBodyID .Update.Empty}}
	id, d := stateID(ctx, *state)
	diags.Append(d...)
	if diags.HasError() {
		return diags
	}
{{- end}}
{{- if .Replace}}
	body, d := updateRequest(ctx, config, &next, state)
{{- else if .OmitMask}}
	// The released API call sends no updateMask. The server updates every
	// field present in the body.
	body, _, d := updateRequest(ctx, config, &next, state)
{{- else}}
	body, mask, d := updateRequest(ctx, config, &next, state)
{{- end}}
	diags.Append(d...)
	if diags.HasError() || body == nil {
		return diags
	}
{{- if .Existing}}
	// The follow-up Update is a write like any other: the overlay completes its body.
	diags.Append(r.beforeWrite(ctx, config, body)...)
	if diags.HasError() {
		return diags
	}
{{- end}}
{{- if and .MaskInBody (not .OmitMask)}}
	{{- if $.Conv.UpdateMaskPointer}}
	body.{{$.Conv.UpdateMaskField}} = &mask
	{{- else}}
	body.{{$.Conv.UpdateMaskField}} = mask
	{{- end}}
{{- end}}
{{- if .UpdateBodyID}}
	// Only the server sets the id, so no Update field sends it. The body names the resource by it.
	body.{{.UpdateBodyID}} = {{if not .UpdateBodyIDValue}}&{{end}}id
{{- end}}
	v, err := r.update(ctx{{if or (not .UpdateIDInBody) .Update.Empty}}, id{{end}}, body{{if and (not .Replace) (not .MaskInBody)}}, mask{{end}})
	if err != nil {
		diags.AddError("Unable to update "+TypeName+" after create", err.Error())
		return diags
	}
{{- if and .Singleton .SingletonID .Update.Empty}}
	// The plan of the create has an unknown id, and Get can leave the id out: the state has the
	// id that Create stored, so it is the prior value of this write.
	diags.Append(r.setState(ctx, v, state, state)...)
{{- else}}
	diags.Append(r.setState(ctx, v, plan, state)...)
{{- end}}
	return diags
}

// updateOnlyState returns the state that the follow-up Update writes: the
// created state with each attribute that Create cannot send set to its planned
// value, or to null when the configuration omits it and Create stored another
// value than the server default. differs is false when no attribute needs it.
func updateOnlyState(ctx context.Context, config tfsdk.Config, plan tfsdk.Plan, state *tfsdk.State) (tfsdk.State, bool, diag.Diagnostics) {
	var diags diag.Diagnostics
	next := tfsdk.State{Schema: state.Schema, Raw: state.Raw.Copy()}
	differs := false
	for _, field := range updateOnlyFields {
		var c, p, s attr.Value
		diags.Append(config.GetAttribute(ctx, path.Root(field.attr), &c)...)
		diags.Append(plan.GetAttribute(ctx, path.Root(field.attr), &p)...)
		diags.Append(state.GetAttribute(ctx, path.Root(field.attr), &s)...)
		if diags.HasError() {
			return next, false, diags
		}
		switch {
		case !c.IsNull() && !p.Equal(s):
			diags.Append(next.SetAttribute(ctx, path.Root(field.attr), p)...)
		case c.IsNull() && !s.IsNull() && !s.Equal(field.serverDefault):
			null, err := s.Type(ctx).ValueFromTerraform(ctx, tftypes.NewValue(s.Type(ctx).TerraformType(ctx), nil))
			if err != nil {
				diags.AddAttributeError(path.Root(field.attr), "Invalid value", err.Error())
				return next, false, diags
			}
			diags.Append(next.SetAttribute(ctx, path.Root(field.attr), null)...)
		default:
			continue
		}
		differs = true
	}
	return next, differs, diags
}

{{end -}}
// Read removes the resource from the state when the API does not find it.
func (r *Resource) Read(ctx context.Context, req resource.ReadRequest, resp *resource.ReadResponse) {
	id, diags := stateID(ctx, req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
	v, err := r.get(ctx, id)
	if {{$cx}}.{{.APINotFound}}(err){{if .Arms}} || err == nil && absent(v){{end}} {
		resp.Diagnostics.AddWarning("Resource disappeared during read",
			fmt.Sprintf("%s with id %v was not found. Terraform removed it from state.", TypeName, id))
		resp.State.RemoveResource(ctx)
		return
	}
	if err != nil {
		resp.Diagnostics.AddError("Unable to read "+TypeName, fmt.Sprintf("id %v: %s", id, err))
		return
	}
	resp.Diagnostics.Append(r.setState(ctx, v, req.State, &resp.State)...)
}

{{if .Upsert -}}
// Update sends every Update field with the Set call, which replaces the
// resource. When no Update field changed, it sends no request and reads the
// resource instead (D14).
{{- else if .Replace -}}
// Update sends every Update field: a PUT replaces the resource. When no
// Update field changed, it sends no request and reads the resource instead
// (D14).
{{- else}}
// Update sends only the Update fields that changed. When none changed, it
// sends no request and reads the resource instead (D14).
{{- end}}
func (r *Resource) Update(ctx context.Context, req resource.UpdateRequest, resp *resource.UpdateResponse) {
	id, diags := stateID(ctx, req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- if .Replace}}
	body, diags := updateRequest(ctx, req.Config, req.Plan, req.State)
{{- else if .OmitMask}}
	// The released API call sends no updateMask. The server updates every
	// field present in the body.
	body, _, diags := updateRequest(ctx, req.Config, req.Plan, req.State)
{{- else}}
	body, mask, diags := updateRequest(ctx, req.Config, req.Plan, req.State)
{{- end}}
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- if .Existing}}
	if body != nil {
		resp.Diagnostics.Append(r.beforeWrite(ctx, req.Config, body)...)
		if resp.Diagnostics.HasError() {
			return
		}
	}
{{- end}}
	var v *{{$sdk}}.{{.Resource}}
	var err error
	if body == nil {
		v, err = r.get(ctx, id)
	} else {
{{- if and .MaskInBody (not .OmitMask)}}
		{{- if $.Conv.UpdateMaskPointer}}
		body.{{$.Conv.UpdateMaskField}} = &mask
		{{- else}}
		body.{{$.Conv.UpdateMaskField}} = mask
		{{- end}}
{{- end}}
{{- if .UpdateBodyID}}
		// Only the server sets the id, so no Update field sends it. The body names the resource by it.
		body.{{.UpdateBodyID}} = {{if not .UpdateBodyIDValue}}&{{end}}id
{{- end}}
		v, err = r.update(ctx{{if or (not .UpdateIDInBody) .Update.Empty}}, id{{end}}, body{{if and (not .Replace) (not .MaskInBody)}}, mask{{end}})
	}
	if {{$cx}}.{{.APINotFound}}(err) {
		// The framework does not allow Update to remove the resource from state.
		// The next refresh removes it through Read.
		resp.Diagnostics.AddError("Resource no longer exists",
			fmt.Sprintf("The API did not find %s with id %v. Run terraform apply without -refresh=false: the refresh removes it from state, and the plan creates it again.", TypeName, id))
		return
	}
	if err != nil {
		resp.Diagnostics.AddError("Unable to update "+TypeName, fmt.Sprintf("id %v: %s", id, err))
		return
	}
	resp.Diagnostics.Append(r.setState(ctx, v, req.Plan, &resp.State)...)
}

{{if .Upsert -}}
// Delete removes the resource from the state only. The API cannot remove it, so
// it keeps the last configuration that Terraform set.
func (r *Resource) Delete(_ context.Context, _ resource.DeleteRequest, resp *resource.DeleteResponse) {
	resp.Diagnostics.AddWarning("Resource not deleted",
		fmt.Sprintf("The API cannot delete %s. Terraform removed it from state, and the API keeps its last configuration.", TypeName))
}
{{- else -}}
// Delete treats a resource that the API does not find as deleted. A 404 of a route that
// does not exist is an error: the resource can still exist.
func (r *Resource) Delete(ctx context.Context, req resource.DeleteRequest, resp *resource.DeleteResponse) {
	id, diags := stateID(ctx, req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
	err := r.delete(ctx, id)
	if err != nil && !{{$cx}}.{{.APINotFound}}(err) {
		resp.Diagnostics.AddError("Unable to delete "+TypeName, fmt.Sprintf("id %v: %s", id, err))
	}
}
{{- end}}

// The API calls. Each returns the error with its HTTP status and body.

func (r *Resource) create(ctx context.Context, body *{{$sdk}}.{{$.Conv.CreateBody}}) (*{{$sdk}}.{{.Resource}}, error) {
	out, httpResp, err := r.client.{{.Create.Method}}(ctx).{{.Create.Body}}(*body).Execute()
	if err != nil {
		return nil, {{$cx}}.{{.NewAPIError}}(httpResp, err)
	}
{{- if .Create.ResponseID}}
	if out == nil || {{if not .Create.ResponseIDValue}}out.{{.Create.ResponseID}} == nil || *out.{{.Create.ResponseID}} == ""{{else}}out.{{.Create.ResponseID}} == ""{{end}} {
		return nil, fmt.Errorf("the API did not return the id of the new resource")
	}
	id := {{if not .Create.ResponseIDValue}}*{{end}}out.{{.Create.ResponseID}}
	// The Create response holds only the id. Read the resource that it created.
	v, err := r.get(ctx, id)
	if err != nil {
		// Return the id with the error, so Create can keep it in the state.
		return &{{$sdk}}.{{.Resource}}{ {{.IDField}}: {{if not .IDValue}}&{{end}}id}, fmt.Errorf("created %s with id %v, but could not read it: %w", TypeName, id, err)
	}
	if v == nil {
		return &{{$sdk}}.{{.Resource}}{ {{.IDField}}: {{if not .IDValue}}&{{end}}id}, fmt.Errorf("created %s with id %v, but the API returned no resource", TypeName, id)
	}
	// The id that Create returned is the id of the resource, also when Get leaves it out.
	if {{if .IDValue}}v.{{.IDField}} == ""{{else}}v.{{.IDField}} == nil || *v.{{.IDField}} == ""{{end}} {
		v.{{.IDField}} = {{if not .IDValue}}&{{end}}id
	}
	return v, nil
}
{{- else}}
	if out == nil {
		return nil, nil
	}
	return {{if .Create.Response}}{{if .Create.ResponseValue}}&{{end}}out.{{.Create.Response}}{{else}}out{{end}}, nil
}
{{- end}}

func (r *Resource) get(ctx context.Context, id {{.IDGoType}}) (*{{$sdk}}.{{.Resource}}, error) {
	out, httpResp, err := r.client.{{.Get.Method}}(ctx{{if not .Singleton}}, id{{end}}).Execute()
	if err != nil {
		return nil, {{$cx}}.{{.NewAPIError}}(httpResp, err)
	}
	if out == nil {
		return nil, nil
	}
