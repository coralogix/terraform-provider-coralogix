{{with .CRUD}}
{{- $sdk := .SDKName}}
{{- $provider := .ProviderName}}
{{- $cx := .CXName}}
// TypeName is the resource type name without the provider prefix.
const TypeName = {{printf "%q" .TypeName}}

var (
	_ resource.Resource                     = (*Resource)(nil)
	_ resource.ResourceWithConfigure        = (*Resource)(nil)
	_ resource.ResourceWithConfigValidators = (*Resource)(nil)
	_ resource.ResourceWithImportState      = (*Resource)(nil)
{{- if .Upgrades}}
	_ resource.ResourceWithUpgradeState     = (*Resource)(nil)
{{- end}}
)

// Resource is the Terraform resource. The provider data must be a
// *{{$provider}}.{{.ClientSet}}.
type Resource struct {
	client *{{$sdk}}.{{.Client}}
}

// NewResource returns the resource. Use it in provider.Resources.
func NewResource() resource.Resource { return &Resource{} }

func (r *Resource) Metadata(_ context.Context, req resource.MetadataRequest, resp *resource.MetadataResponse) {
	resp.TypeName = req.ProviderTypeName + "_" + TypeName
}

func (r *Resource) Schema(_ context.Context, _ resource.SchemaRequest, resp *resource.SchemaResponse) {
	resp.Schema = Schema()
}

func (r *Resource) ConfigValidators(context.Context) []resource.ConfigValidator {
	return ConfigValidators()
}

func (r *Resource) Configure(_ context.Context, req resource.ConfigureRequest, resp *resource.ConfigureResponse) {
	if req.ProviderData == nil {
		return // The provider is not configured yet.
	}
	cs, ok := req.ProviderData.(*{{$provider}}.{{.ClientSet}})
	if !ok {
		resp.Diagnostics.AddError("Unexpected provider data",
			fmt.Sprintf("The provider data is %T. The resource needs *{{$provider}}.{{.ClientSet}}.", req.ProviderData))
		return
	}
	r.client = cs.{{.Accessor}}()
}

// ImportState sets the id. The Read after the import sets the other attributes.
func (r *Resource) ImportState(ctx context.Context, req resource.ImportStateRequest, resp *resource.ImportStateResponse) {
{{- if .IDBits}}
	id, err := strconv.ParseInt(req.ID, 10, {{.IDBits}})
	if err != nil {
		resp.Diagnostics.AddError("Invalid import ID", fmt.Sprintf("The import ID %q is not a valid {{.IDGoType}}.", req.ID))
		return
	}
	resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), {{.IDGoType}}(id))...)
{{- else}}
	resource.ImportStatePassthroughID(ctx, path.Root({{printf "%q" .IDAttr}}), req, resp)
{{- end}}
}

func (r *Resource) Create(ctx context.Context, req resource.CreateRequest, resp *resource.CreateResponse) {
	resp.Diagnostics.Append(validateCreate(ctx, req.Config, req.Plan)...)
	if resp.Diagnostics.HasError() {
		return
	}
	var plan {{.Model}}
	resp.Diagnostics.Append(req.Plan.Get(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}
	body, diags := expandCreate(ctx, &plan)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
	v, err := r.create(ctx, body)
	if err != nil {
		resp.Diagnostics.AddError("Unable to create "+TypeName, err.Error())
		return
	}
	diags = setState(ctx, v, req.Plan, &resp.State)
	resp.Diagnostics.Append(diags...)
{{- if .Singleton}}
	if diags.HasError() {
		// The singleton exists, but the state is not complete. Keep the id, so
		// Terraform marks the resource as tainted and can delete it.
		resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root("id"), TypeName)...)
	}
{{- else}}
	if diags.HasError() && v != nil{{if not .IDValue}} && v.{{.IDField}} != nil{{end}} {
		// The resource exists, but the state is not complete. Keep the id, so
		// Terraform marks the resource as tainted and can delete it.
		resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), {{if not .IDValue}}*{{end}}v.{{.IDField}})...)
	}
{{- end}}
}

// Read removes the resource from the state when the API does not find it.
func (r *Resource) Read(ctx context.Context, req resource.ReadRequest, resp *resource.ReadResponse) {
	id, diags := stateID(ctx, req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
	v, err := r.get(ctx, id)
	if {{$cx}}.{{.APICode}}(err) == http.StatusNotFound {
		resp.Diagnostics.AddWarning("Resource disappeared during read",
			fmt.Sprintf("%s with id %v was not found. Terraform removed it from state.", TypeName, id))
		resp.State.RemoveResource(ctx)
		return
	}
	if err != nil {
		resp.Diagnostics.AddError("Unable to read "+TypeName, fmt.Sprintf("id %v: %s", id, err))
		return
	}
	resp.Diagnostics.Append(setState(ctx, v, req.State, &resp.State)...)
}

{{if .Replace -}}
// Update sends every Update field: a PUT replaces the resource. When no
// Update field changed, it sends no request and reads the resource instead
// (D14).
{{- else}}
// Update sends only the Update fields that changed. When none changed, it
// sends no request and reads the resource instead (D14).
{{- end}}
func (r *Resource) Update(ctx context.Context, req resource.UpdateRequest, resp *resource.UpdateResponse) {
	id, diags := stateID(ctx, req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- if .Replace}}
body, diags := updateRequest(ctx, req.Config, req.Plan, req.State)
{{- else}}
body, mask, diags := updateRequest(ctx, req.Config, req.Plan, req.State)
{{- end}}
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
	var v *{{$sdk}}.{{.Resource}}
	var err error
	if body == nil {
		v, err = r.get(ctx, id)
	} else {
		v, err = r.update(ctx{{if not .UpdateIDInBody}}, id{{end}}, body{{if not .Replace}}, mask{{end}})
	}
	if {{$cx}}.{{.APICode}}(err) == http.StatusNotFound {
		resp.Diagnostics.AddWarning("Resource disappeared during update",
			fmt.Sprintf("The API did not find %s with id %v. Terraform removed it from state.", TypeName, id))
		resp.State.RemoveResource(ctx)
		return
	}
	if err != nil {
		resp.Diagnostics.AddError("Unable to update "+TypeName, fmt.Sprintf("id %v: %s", id, err))
		return
	}
	resp.Diagnostics.Append(setState(ctx, v, req.Plan, &resp.State)...)
}

// Delete treats a resource that the API does not find as deleted.
func (r *Resource) Delete(ctx context.Context, req resource.DeleteRequest, resp *resource.DeleteResponse) {
	id, diags := stateID(ctx, req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
	err := r.delete(ctx, id)
	if err != nil && {{$cx}}.{{.APICode}}(err) != http.StatusNotFound {
		resp.Diagnostics.AddError("Unable to delete "+TypeName, fmt.Sprintf("id %v: %s", id, err))
	}
}

// The API calls. Each returns the error with its HTTP status and body.

func (r *Resource) create(ctx context.Context, body *{{$sdk}}.{{$.Conv.CreateBody}}) (*{{$sdk}}.{{.Resource}}, error) {
	out, httpResp, err := r.client.{{.Create.Method}}(ctx).{{.Create.Body}}(*body).Execute()
	if err != nil {
		return nil, {{$cx}}.{{.NewAPIError}}(httpResp, err)
	}
	if out == nil {
		return nil, nil
	}
	return {{if .Create.Response}}out.{{.Create.Response}}{{else}}out{{end}}, nil
}

func (r *Resource) get(ctx context.Context, id {{.IDGoType}}) (*{{$sdk}}.{{.Resource}}, error) {
	out, httpResp, err := r.client.{{.Get.Method}}(ctx{{if not .Singleton}}, id{{end}}).Execute()
	if err != nil {
		return nil, {{$cx}}.{{.NewAPIError}}(httpResp, err)
	}
	if out == nil {
		return nil, nil
	}
	return {{if .Get.Response}}out.{{.Get.Response}}{{else}}out{{end}}, nil
}

func (r *Resource) update(ctx context.Context{{if not .UpdateIDInBody}}, id {{.IDGoType}}{{end}}, body *{{$sdk}}.{{$.Conv.UpdateBody}}{{if not .Replace}}, mask string{{end}}) (*{{$sdk}}.{{.Resource}}, error) {
	out, httpResp, err := r.client.{{.Update.Method}}(ctx{{if and (not .Singleton) (not .UpdateIDInBody)}}, id{{end}}).{{.Update.Body}}(*body){{if not .Replace}}.{{.UpdateMask}}(mask){{end}}.Execute()
	if err != nil {
		return nil, {{$cx}}.{{.NewAPIError}}(httpResp, err)
	}
	if out == nil {
		return nil, nil
	}
	return {{if .Update.Response}}out.{{.Update.Response}}{{else}}out{{end}}, nil
}

func (r *Resource) delete(ctx context.Context, id {{.IDGoType}}) error {
	_, httpResp, err := r.client.{{.Delete.Method}}(ctx{{if not .Singleton}}, id{{end}}).Execute()
	return {{$cx}}.{{.NewAPIError}}(httpResp, err)
}

{{if .Existing -}}
// setState writes the resource in an API response to the state. prior is the plan after Create
// or Update, or the state before Read. A state upgrade has no prior of this schema version, so
// it passes nil. flatten keeps the released read rules, so a value that is empty in both the
// response and prior does not keep its form from prior. flatten returns an error when the
// response has no resource.
{{- else -}}
// setState writes the resource in an API response to the state. A value that
// is empty in both the response and prior keeps its form from prior: the plan
// after Create or Update, or the state before Read. flatten
// returns an error when the response has no resource.
{{- end}}
func setState(ctx context.Context, v *{{$sdk}}.{{.Resource}}, prior tfData, state *tfsdk.State) diag.Diagnostics {
	m, diags := flatten(ctx, v{{if $.Conv.HasPrior}}, priorModel(ctx, prior){{end}})
	if diags.HasError() {
		return diags
	}
{{- if .Singleton}}
	m.Id = types.StringValue(TypeName) // a singleton has a fixed id (D18)
{{- end}}
	diags.Append(state.Set(ctx, m)...)
{{- if not .Existing}}
	if diags.HasError() {
		return diags
	}
	diags.Append(keepPriorEmpty(ctx, prior, state)...)
{{- end}}
	return diags
}

{{- if $.Conv.HasPrior}}

// priorModel returns the model in the state or the plan, or nil when there is none or it
// cannot be read. The prior keeps the order of lists that the API does not order, and the text
// of documents that the API returns in another format.
func priorModel(ctx context.Context, data tfData) *{{.Model}} {
	var m {{.Model}}
	if data == nil || data.Get(ctx, &m).HasError() {
		return nil
	}
	return &m
}
{{- end}}
{{- if .Existing}}

// Flatten returns the Terraform model of a resource in an API response, for a data source that
// uses the schema and the model of this resource. It has no prior model.
func Flatten(ctx context.Context, v *{{$sdk}}.{{.Resource}}) (*{{.Model}}, diag.Diagnostics) {
	return flatten(ctx, v{{if $.Conv.HasPrior}}, nil{{end}})
}
{{- end}}
{{- if .Upgrades}}

// UpgradeState upgrades the state of an older schema version. The prior schema only decodes the
// old state. The upgrader reads the resource from the API, so it does not translate any value.
func (r *Resource) UpgradeState(context.Context) map[int64]resource.StateUpgrader {
{{- range .Upgrades}}
	prior{{.Version}} := {{.Alias}}.{{.Func}}()
{{- end}}
	return map[int64]resource.StateUpgrader{
{{- range .Upgrades}}
		{{.Version}}: {PriorSchema: &prior{{.Version}}, StateUpgrader: r.upgradeByRefresh},
{{- end}}
	}
}

func (r *Resource) upgradeByRefresh(ctx context.Context, req resource.UpgradeStateRequest, resp *resource.UpgradeStateResponse) {
	if req.State == nil {
		resp.Diagnostics.AddError("Missing prior state", "The state upgrade request has no prior state.")
		return
	}
	id, diags := stateID(ctx, *req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
	v, err := r.get(ctx, id)
	if {{$cx}}.{{.APICode}}(err) == http.StatusNotFound {
		resp.Diagnostics.AddWarning("Resource disappeared during state upgrade",
			fmt.Sprintf("%s with id %v was not found. Terraform removed it from state.", TypeName, id))
		resp.State.RemoveResource(ctx)
		return
	}
	if err != nil {
		resp.Diagnostics.AddError("Unable to read "+TypeName, fmt.Sprintf("id %v: %s", id, err))
		return
	}
	resp.Diagnostics.Append(setState(ctx, v, nil, &resp.State)...)
}
{{- end}}

// stateID returns the id in the state.
func stateID(ctx context.Context, state tfsdk.State) ({{.IDGoType}}, diag.Diagnostics) {
	var id types.{{.IDTFType}}
	diags := state.GetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), &id)
	return id.Value{{.IDTFType}}(), diags
}
{{- end}}
