// Resource is the Terraform resource. The provider data must be a
// *{{$provider}}.{{.ClientSet}}.
type Resource struct {
	client *{{$sdk}}.{{.Client}}
{{- if .Existing}}
	hooks  Hooks
{{- end}}
}

{{- if .Existing}}

// Hooks are handwritten steps around generated CRUD. Pass them to NewResource
// so a resource that is used without the overlay package does not silently skip them.
type Hooks struct {
	// BeforeWrite mutates the expanded request body before the API call.
	BeforeWrite func(context.Context, tfsdk.Config, any) diag.Diagnostics
	// AfterRead mutates state after flatten. prior is the plan after Create or
	// Update, or the state before Read.
	AfterRead func(context.Context, *tfsdk.State, any) diag.Diagnostics
	// BeforeFlatten mutates the API value before flatten, for a value that only an older
	// record has, such as a deprecated field that a newer one replaces.
	BeforeFlatten func(context.Context, *{{$sdk}}.{{.Resource}}) diag.Diagnostics
{{- if $.Conv.UsesUnsupported}}
	// AllowUnsupported says that the resource is managed in a way that does not read the
	// unsupported fields and arms (unsupportedArms), so flatten does not report them. It gets the
	// plan after Create or Update, or the state before Read; a state upgrade gets the prior state.
	AllowUnsupported func(context.Context, any) bool
{{- end}}
{{- if $.AfterFlatten}}
	// AfterFlatten projects API values into the Terraform model before it enters state.
	AfterFlatten func(context.Context, *{{$.Model}}, *{{$sdk}}.{{.Resource}}) diag.Diagnostics
{{- end}}
{{- if .GetHooks}}
	// Get replaces the Execute step of the Get call that Read, the data source, and every read
	// after a write make (nil: the generated call). It receives a factory of the generated
	// request, which already holds the context, the id, and the fixed query values of the
	// contract: every call of the factory returns a fresh request that the hook adds a query
	// parameter to and executes, as many times as it needs (a retry without the parameter calls
	// the factory again). It returns what Execute returns: the whole Get response, the HTTP
	// response, and the error. The generated code classifies the error as it does for its own
	// call (a 404 of the resource is a resource that is gone, a 404 of a route that does not
	// exist is an error), and takes the resource out of the response.
	Get func(context.Context, func() {{$sdk}}.{{.GetRequest}}) (*{{$sdk}}.{{.GetResponse}}, *http.Response, error)
	// AfterGet receives the whole Get response, with the values next to the resource that the
	// generated code drops, and the state that was just written from it. It runs after
	// the state was written and before AfterRead, only for a state that a Get call produced
	// (the response of a write is no Get response), and not when flatten failed.
	AfterGet func(context.Context, *tfsdk.State, *{{$sdk}}.{{.GetResponse}}) diag.Diagnostics
{{- end}}
	// ValidateConfig adds checks that no attribute validator expresses, such as a rule over
	// the items of a set.
	ValidateConfig func(context.Context, tfsdk.Config) diag.Diagnostics
{{- if $.ModifyPlanHook}}
	// ModifyPlan runs last in the generated ModifyPlan, never on destroy, after the generated
	// plan steps. req.Plan is the plan before the hook; resp.Plan starts as the plan after the
	// generated steps, so the hook sets a planned value there. It must tolerate null and unknown
	// values.
	ModifyPlan func(context.Context, resource.ModifyPlanRequest, *resource.ModifyPlanResponse)
{{- end}}
}

// NewResource returns the resource. Use it in provider.Resources.
func NewResource(hooks Hooks) resource.Resource {
	return &Resource{hooks: hooks}
}

// NewResourceWithClient returns the resource with an injected API client.
func NewResourceWithClient(client *{{$sdk}}.{{.Client}}, hooks Hooks) resource.Resource {
	return &Resource{client: client, hooks: hooks}
}
{{- else}}

// NewResource returns the resource. Use it in provider.Resources.
func NewResource() resource.Resource { return &Resource{} }

// NewResourceWithClient returns the resource with an injected API client.
func NewResourceWithClient(client *{{$sdk}}.{{.Client}}) resource.Resource {
	return &Resource{client: client}
}
{{- end}}

func (r *Resource) Metadata(_ context.Context, req resource.MetadataRequest, resp *resource.MetadataResponse) {
	resp.TypeName = req.ProviderTypeName + "_" + TypeName
}

func (r *Resource) Schema(_ context.Context, _ resource.SchemaRequest, resp *resource.SchemaResponse) {
	resp.Schema = Schema()
}

func (r *Resource) ConfigValidators(context.Context) []resource.ConfigValidator {
	return ConfigValidators()
}
{{- if .Existing}}

{{- if and $.ModifyPlanHook (not $.EqualityPlan)}}

var _ resource.ResourceWithModifyPlan = (*Resource)(nil)

// ModifyPlan runs the ModifyPlan hook, if there is one, unless the plan destroys the resource.
func (r *Resource) ModifyPlan(ctx context.Context, req resource.ModifyPlanRequest, resp *resource.ModifyPlanResponse) {
	if req.Plan.Raw.IsNull() || r.hooks.ModifyPlan == nil {
		return
	}
	r.hooks.ModifyPlan(ctx, req, resp)
}
{{- end}}

func (r *Resource) ValidateConfig(ctx context.Context, req resource.ValidateConfigRequest, resp *resource.ValidateConfigResponse) {
{{- if or $.UniqueChecks $.Float32Paths}}
	resp.Diagnostics.Append(configChecks(req.Config)...)
{{- end}}
	if r.hooks.ValidateConfig != nil {
		resp.Diagnostics.Append(r.hooks.ValidateConfig(ctx, req.Config)...)
	}
}

// beforeWrite checks the resolved configuration again, because a value that comes from another
// resource is unknown while Terraform validates the configuration, and then runs the BeforeWrite hook.
func (r *Resource) beforeWrite(ctx context.Context, config tfsdk.Config, body any) diag.Diagnostics {
	var diags diag.Diagnostics
{{- if or $.UniqueChecks $.Float32Paths}}
	diags.Append(configChecks(config)...)
	if diags.HasError() {
		return diags
	}
{{- end}}
	if r.hooks.BeforeWrite != nil {
		diags.Append(r.hooks.BeforeWrite(ctx, config, body)...)
	}
	return diags
}
{{- if or $.UniqueChecks $.Float32Paths}}

// configChecks runs the checks that the behavior-overrides file asks for: the uniqueBy lines and
// the float32 precision of the float attributes.
func configChecks(config tfsdk.Config) diag.Diagnostics {
	var diags diag.Diagnostics
{{- range $.UniqueChecks}}
	diags.Append(checkUnique(config.Raw, {{printf "%q" .Attr}}, {{printf "%q" .Key}})...)
{{- end}}
{{- if $.Float32Paths}}
	diags.Append(checkFloat32Precision(config.Raw)...)
{{- end}}
	return diags
}
{{- end}}
{{- if $.UniqueChecks}}

// checkUnique reports an item of the collection that has the same key value as an earlier one.
// A null or unknown value is not a duplicate.
func checkUnique(config tftypes.Value, collection, key string) diag.Diagnostics {
	var diags diag.Diagnostics
	var root map[string]tftypes.Value
	if config.IsNull() || !config.IsKnown() || config.As(&root) != nil {
		return diags
	}
	var items []tftypes.Value
	if value := root[collection]; !value.IsKnown() || value.IsNull() || value.As(&items) != nil {
		return diags
	}
	seen := map[string]bool{}
	for _, item := range items {
		var fields map[string]tftypes.Value
		if !item.IsKnown() || item.IsNull() || item.As(&fields) != nil {
			continue
		}
		var text string
		if v := fields[key]; !v.IsKnown() || v.IsNull() || v.As(&text) != nil {
			continue
		}
		if seen[text] {
			diags.AddAttributeError(path.Root(collection), "Duplicate "+collection+" "+key,
				fmt.Sprintf("Only one item of %s can set %s to %q.", collection, key, text))
			continue
		}
		seen[text] = true
	}
	return diags
}
{{- end}}
{{- if $.Float32Paths}}

// float32Attributes are the attributes that the API stores as float32.
var float32Attributes = map[string]bool{
{{- range $.Float32Paths}}
	{{printf "%q" .}}: true,
{{- end}}
}

// checkFloat32Precision reports a float32 attribute that the API would return as another number:
// the state would then differ from the configuration.
func checkFloat32Precision(config tftypes.Value) diag.Diagnostics {
	var diags diag.Diagnostics
	_ = tftypes.Walk(config, func(p *tftypes.AttributePath, v tftypes.Value) (bool, error) {
		if !float32Attributes[attributeKey(p)] || !v.IsKnown() || v.IsNull() {
			return true, nil
		}
		var given big.Float
		if v.As(&given) != nil {
			return true, nil
		}
		// The state holds the shortest decimal of the float32. Terraform sends the configured number
		// as a float64 when that is exact, and as the exact decimal otherwise, so compare the shortest
		// decimal of each at its own precision, with no narrowing of a long decimal.
		stored, _ := given.Float32()
		returned := strconv.FormatFloat(float64(stored), 'f', -1, 32)
		if asked := given.Text('f', -1); asked != returned {
			diags.AddAttributeError(path.Root(string(p.Steps()[0].(tftypes.AttributeName))), "Invalid "+attributeKey(p)+" precision",
				fmt.Sprintf("%s is %s, but the API stores it as float32 and would return %s. Configure %s instead to avoid state drift.",
					attributeKey(p), asked, returned, returned))
		}
		return true, nil
	})
	return diags
}
{{- end}}
{{- if or $.Float32Paths $.EnumAliases}}

// attributeKey is the dotted Terraform path of an attribute, without the steps of lists, sets, and maps.
func attributeKey(p *tftypes.AttributePath) string {
	var names []string
	for _, step := range p.Steps() {
		if name, ok := step.(tftypes.AttributeName); ok {
			names = append(names, string(name))
		}
	}
	return strings.Join(names, ".")
}
{{- end}}
{{- end}}

func (r *Resource) Configure(_ context.Context, req resource.ConfigureRequest, resp *resource.ConfigureResponse) {
	if req.ProviderData == nil {
		return // The provider is not configured yet.
	}
	cs, ok := req.ProviderData.(*{{$provider}}.{{.ClientSet}})
	if !ok {
		resp.Diagnostics.AddError("Unexpected provider data",
			fmt.Sprintf("The provider data is %T. The resource needs *{{$provider}}.{{.ClientSet}}.", req.ProviderData))
		return
	}
	r.client = cs.{{.Accessor}}()
}

// ImportState sets the id. The Read after the import sets the other attributes.
func (r *Resource) ImportState(ctx context.Context, req resource.ImportStateRequest, resp *resource.ImportStateResponse) {
{{- if .IDBits}}
	id, err := strconv.ParseInt(req.ID, 10, {{.IDBits}})
	if err != nil {
		resp.Diagnostics.AddError("Invalid import ID", fmt.Sprintf("The import ID %q is not a valid {{.IDGoType}}.", req.ID))
		return
	}
	resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), idStateValue({{.IDGoType}}(id)))...)
{{- else}}
	resource.ImportStatePassthroughID(ctx, path.Root({{printf "%q" .IDAttr}}), req, resp)
{{- end}}
}

func (r *Resource) Create(ctx context.Context, req resource.CreateRequest, resp *resource.CreateResponse) {
{{- if .GetHooks}}
	ctx, _ = withGetResult(ctx)
{{- end}}
	resp.Diagnostics.Append(validateCreate(ctx, req.Config, req.Plan)...)
	if resp.Diagnostics.HasError() {
		return
	}
	var plan {{.Model}}
	resp.Diagnostics.Append(req.Plan.Get(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}
	body, diags := expandCreate(ctx, &plan)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- if .Existing}}
	resp.Diagnostics.Append(r.beforeWrite(ctx, req.Config, body)...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- end}}
{{- if .UpdateOnly}}
	resp.Diagnostics.Append(validateUpdateOnly(ctx, req.Config, req.Plan)...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- end}}
	v, err := r.create(ctx, body)
	if err != nil {
		resp.Diagnostics.AddError("Unable to create "+TypeName, err.Error())
{{- if .Create.ResponseID}}
		if id, ok := apiID(v); ok {
			// The resource exists, but reading it failed. Keep the id, so Terraform marks the
			// resource as tainted and can delete it.
			resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), idStateValue(id))...)
		}
{{- else if or .Create.Empty .Overwrite}}
		if v != nil {
			// The singleton is set, but reading it failed. Keep the plan with the fixed id, as the
			// state of what was set, so Terraform marks the resource as tainted.
			resp.State.Raw = req.Plan.Raw
			resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root("id"), SingletonID)...)
		}
{{- end}}
		return
	}
	diags = r.setState(ctx, v, req.Plan, &resp.State)
	resp.Diagnostics.Append(diags...)
{{- if .UpdateOnly}}
	if !diags.HasError() {
		// The resource exists and the state is complete. An error here leaves
		// the state, so Terraform marks the resource as tainted.
		resp.Diagnostics.Append(r.applyUpdateOnly(ctx, req.Config, req.Plan, &resp.State)...)
	}
{{- end}}
{{- if .Singleton}}
	if diags.HasError() {
		// The singleton exists, but the state is not complete. Keep the id, so
		// Terraform marks the resource as tainted and can delete it.
		resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root("id"), SingletonID)...)
	}
{{- else}}
	if id, ok := apiID(v); diags.HasError() && ok {
		// The resource exists, but the state is not complete. Keep the id, so
		// Terraform marks the resource as tainted and can delete it.
		resp.Diagnostics.Append(resp.State.SetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), idStateValue(id))...)
	}
{{- end}}
}

{{if .UpdateOnly -}}
// updateOnlyFields are the attributes that Create cannot send. Create stores
// their server default.
var updateOnlyFields = []struct {
	attr          string
	serverDefault attr.Value
}{
{{- range .UpdateOnly}}
	{attr: {{printf "%q" .Attr}}, serverDefault: {{.Default}}},
{{- end}}
}

// validateUpdateOnly stops Create before the API call when a configured
// attribute that only the follow-up Update sends is still unknown.
func validateUpdateOnly(ctx context.Context, config tfsdk.Config, plan tfsdk.Plan) diag.Diagnostics {
	var diags diag.Diagnostics
	for _, field := range updateOnlyFields {
		var c, p attr.Value
		diags.Append(config.GetAttribute(ctx, path.Root(field.attr), &c)...)
		diags.Append(plan.GetAttribute(ctx, path.Root(field.attr), &p)...)
		if diags.HasError() {
			return diags
		}
		validateRequestValue(path.Root(field.attr), c, p, true, &diags)
	}
	return diags
}

// applyUpdateOnly follows Create with an Update when the configuration sets an
// attribute that Create cannot send to another value than the one Create
// stored, or omits it and Create stored another value than the server default.
// The Update body is the created resource with the configured values, and
// without the omitted ones, so the server stores their default.
func (r *Resource) applyUpdateOnly(ctx context.Context, config tfsdk.Config, plan tfsdk.Plan, state *tfsdk.State) diag.Diagnostics {
	next, differs, diags := updateOnlyState(ctx, config, plan, state)
	if !differs || diags.HasError() {
		return diags
	}
{{- if or (not .UpdateIDInBody) .UpdateBodyID .Update.Empty}}
	id, d := stateID(ctx, *state)
	diags.Append(d...)
	if diags.HasError() {
		return diags
	}
{{- end}}
{{- if .Replace}}
	body, d := updateRequest(ctx, config, &next, state)
{{- else if .OmitMask}}
	// The released API call sends no updateMask. The server updates every
	// field present in the body.
	body, _, d := updateRequest(ctx, config, &next, state)
{{- else}}
	body, mask, d := updateRequest(ctx, config, &next, state)
{{- end}}
	diags.Append(d...)
	if diags.HasError() || body == nil {
		return diags
	}
{{- if .Existing}}
	// The follow-up Update is a write like any other: the overlay completes its body.
	diags.Append(r.beforeWrite(ctx, config, body)...)
	if diags.HasError() {
		return diags
	}
{{- end}}
{{- if and .MaskInBody (not .OmitMask)}}
	{{- if $.Conv.UpdateMaskPointer}}
	body.{{$.Conv.UpdateMaskField}} = &mask
	{{- else}}
	body.{{$.Conv.UpdateMaskField}} = mask
	{{- end}}
{{- end}}
{{- if .UpdateBodyID}}
	// Only the server sets the id, so no Update field sends it. The body names the resource by it.
	body.{{.UpdateBodyID}} = {{if not .UpdateBodyIDValue}}&{{end}}id
{{- end}}
	v, err := r.update(ctx{{if or (not .UpdateIDInBody) .Update.Empty}}, id{{end}}, body{{if .UpdateMask}}, mask{{end}})
	if err != nil {
		diags.AddError("Unable to update "+TypeName+" after create", err.Error())
		return diags
	}
{{- if and .Singleton .SingletonID .Update.Empty}}
	// The plan of the create has an unknown id, and Get can leave the id out: the state has the
	// id that Create stored, so it is the prior value of this write.
	diags.Append(r.setState(ctx, v, state, state)...)
{{- else}}
	diags.Append(r.setState(ctx, v, plan, state)...)
{{- end}}
	return diags
}

// updateOnlyState returns the state that the follow-up Update writes: the
// created state with each attribute that Create cannot send set to its planned
// value, or to null when the configuration omits it and Create stored another
// value than the server default. differs is false when no attribute needs it.
func updateOnlyState(ctx context.Context, config tfsdk.Config, plan tfsdk.Plan, state *tfsdk.State) (tfsdk.State, bool, diag.Diagnostics) {
	var diags diag.Diagnostics
	next := tfsdk.State{Schema: state.Schema, Raw: state.Raw.Copy()}
	differs := false
	for _, field := range updateOnlyFields {
		var c, p, s attr.Value
		diags.Append(config.GetAttribute(ctx, path.Root(field.attr), &c)...)
		diags.Append(plan.GetAttribute(ctx, path.Root(field.attr), &p)...)
		diags.Append(state.GetAttribute(ctx, path.Root(field.attr), &s)...)
		if diags.HasError() {
			return next, false, diags
		}
		switch {
		case !c.IsNull() && !p.Equal(s):
			diags.Append(next.SetAttribute(ctx, path.Root(field.attr), p)...)
		case c.IsNull() && !s.IsNull() && !s.Equal(field.serverDefault):
			null, err := s.Type(ctx).ValueFromTerraform(ctx, tftypes.NewValue(s.Type(ctx).TerraformType(ctx), nil))
			if err != nil {
				diags.AddAttributeError(path.Root(field.attr), "Invalid value", err.Error())
				return next, false, diags
			}
			diags.Append(next.SetAttribute(ctx, path.Root(field.attr), null)...)
		default:
			continue
		}
		differs = true
	}
	return next, differs, diags
}

{{end -}}
// Read removes the resource from the state when the API does not find it.
func (r *Resource) Read(ctx context.Context, req resource.ReadRequest, resp *resource.ReadResponse) {
{{- if .GetHooks}}
	ctx, _ = withGetResult(ctx)
{{- end}}
	id, diags := stateID(ctx, req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- if .Get.IDs}}
	if id == "" {
		resp.Diagnostics.AddWarning("Resource has no id", "The state has no resource id. Terraform removed it from state so it can be recreated.")
		resp.State.RemoveResource(ctx)
		return
	}
{{- end}}
	v, err := r.get(ctx, id)
	if {{$cx}}.{{.APINotFound}}(err){{if .Get.IDs}} || err == nil && v == nil{{end}}{{if .Arms}} || err == nil && absent(v){{end}} {
		resp.Diagnostics.AddWarning("Resource disappeared during read",
			fmt.Sprintf("%s with id %v was not found. Terraform removed it from state.", TypeName, id))
		resp.State.RemoveResource(ctx)
		return
	}
	if err != nil {
		resp.Diagnostics.AddError("Unable to read "+TypeName, fmt.Sprintf("id %v: %s", id, err))
		return
	}
	resp.Diagnostics.Append(r.setState(ctx, v, req.State, &resp.State)...)
}

{{if .Upsert -}}
// Update sends every Update field with the Set call, which replaces the
// resource. When no Update field changed, it sends no request and reads the
// resource instead (D14).
{{- else if .Replace -}}
// Update sends every Update field: a PUT replaces the resource. When no
// Update field changed, it sends no request and reads the resource instead
// (D14).
{{- else}}
// Update sends only the Update fields that changed. When none changed, it
// sends no request and reads the resource instead (D14).
{{- end}}
func (r *Resource) Update(ctx context.Context, req resource.UpdateRequest, resp *resource.UpdateResponse) {
{{- if .GetHooks}}
	ctx, _ = withGetResult(ctx)
{{- end}}
	id, diags := stateID(ctx, req.State)
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- if .Replace}}
	body, diags := updateRequest(ctx, req.Config, req.Plan, req.State)
{{- else if .OmitMask}}
	// The released API call sends no updateMask. The server updates every
	// field present in the body.
	body, _, diags := updateRequest(ctx, req.Config, req.Plan, req.State)
{{- else}}
	body, mask, diags := updateRequest(ctx, req.Config, req.Plan, req.State)
{{- end}}
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- if .Existing}}
	if body != nil {
		resp.Diagnostics.Append(r.beforeWrite(ctx, req.Config, body)...)
		if resp.Diagnostics.HasError() {
			return
		}
	}
{{- end}}
	var v *{{$sdk}}.{{.Resource}}
	var err error
	if body == nil {
		v, err = r.get(ctx, id)
	} else {
{{- if and .MaskInBody (not .OmitMask)}}
		{{- if $.Conv.UpdateMaskPointer}}
		body.{{$.Conv.UpdateMaskField}} = &mask
		{{- else}}
		body.{{$.Conv.UpdateMaskField}} = mask
		{{- end}}
{{- end}}
{{- if .UpdateBodyID}}
		// Only the server sets the id, so no Update field sends it. The body names the resource by it.
		body.{{.UpdateBodyID}} = {{if not .UpdateBodyIDValue}}&{{end}}id
{{- end}}
		v, err = r.update(ctx{{if or (not .UpdateIDInBody) .Update.Empty}}, id{{end}}, body{{if .UpdateMask}}, mask{{end}})
	}
	if {{$cx}}.{{.APINotFound}}(err) {
		// The framework does not allow Update to remove the resource from state.
		// The next refresh removes it through Read.
		resp.Diagnostics.AddError("Resource no longer exists",
			fmt.Sprintf("The API did not find %s with id %v. Run terraform apply without -refresh=false: the refresh removes it from state, and the plan creates it again.", TypeName, id))
		return
	}
	if err != nil {
		resp.Diagnostics.AddError("Unable to update "+TypeName, fmt.Sprintf("id %v: %s", id, err))
