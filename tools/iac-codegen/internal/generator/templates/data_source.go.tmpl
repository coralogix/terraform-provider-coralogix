	"{{.CRUD.ProviderPkg}}"
	"{{.CRUD.CXPkg}}"
	"{{.DataSource.UtilsPkg}}"
{{- if $.DataSource.Show}}
	"{{.Conv.SDKPkg}}"
{{- end}}
)
{{with .CRUD}}
{{- $name := $.DataSource.Name}}
{{- $provider := .ProviderName}}
{{- $cx := .CXName}}
var (
	_ datasource.DataSource              = (*DataSource)(nil)
	_ datasource.DataSourceWithConfigure = (*DataSource)(nil)
)

{{if .Singleton -}}
// DataSource reads the {{.TypeName}} singleton with the schema, the model, and the conversion of the
// resource. It takes no input.
{{- else if $name -}}
// DataSource reads one {{.TypeName}} by id or by name with the schema, the model, and the
// conversion of the resource.
{{- else -}}
// DataSource reads one {{.TypeName}} by id with the schema, the model, and the conversion of the
// resource.
{{- end}}
type DataSource struct {
	// resource holds the API client and the API calls.
	resource Resource
}
{{- if .Existing}}

// NewDataSource returns the data source. Use it in provider.DataSources. Pass the hooks of the
// resource: the data source runs BeforeFlatten. It has no prior plan or state, so it does not run
// AfterRead.
func NewDataSource(hooks Hooks) datasource.DataSource {
	return &DataSource{resource: Resource{hooks: hooks}}
}
{{- else}}

// NewDataSource returns the data source. Use it in provider.DataSources.
func NewDataSource() datasource.DataSource { return &DataSource{} }
{{- end}}

func (d *DataSource) Metadata(_ context.Context, req datasource.MetadataRequest, resp *datasource.MetadataResponse) {
	resp.TypeName = req.ProviderTypeName + "_" + TypeName
}

{{if .Singleton -}}
// Schema is the schema of the resource with every attribute computed.
{{- else if $name -}}
// Schema is the schema of the resource with every attribute computed. The configuration sets
// exactly one of the id and the name.
{{- else -}}
// Schema is the schema of the resource with every attribute computed, except the id, which the
// configuration sets.
{{- end}}
func (d *DataSource) Schema(_ context.Context, _ datasource.SchemaRequest, resp *datasource.SchemaResponse) {
{{- if or $.DataSource.IDSchema $name}}
	s := Schema()
	resp.Schema = utils.FrameworkDatasourceSchemaFromFrameworkResourceSchema(s)
{{- if ne .IDAttr "id"}}
	if a, ok := s.Attributes["id"]; ok {
		// The copy makes "id" the lookup attribute. Here it is a value of the resource.
		resp.Schema.Attributes["id"] = utils.ConvertAttribute(a)
	}
{{- end}}
	id := s.Attributes[{{printf "%q" .IDAttr}}]
	resp.Schema.Attributes[{{printf "%q" .IDAttr}}] = schema.{{.IDTFType}}Attribute{
{{- if .Singleton}}
		{{if $.DataSource.QueryID}}Optional:            true,
		Computed:            true,{{else}}
		Computed:            true,
{{end}}
{{- else if $name}}
		Optional:            true,
{{- else}}
		Required:            true,
{{- end}}
		Description:         id.GetDescription(),
		MarkdownDescription: id.GetMarkdownDescription(),
{{- if $name}}
		Validators: []validator.{{.IDTFType}}{
			{{$name.Validator}}.ExactlyOneOf(path.MatchRelative().AtParent().AtName({{printf "%q" $name.Attr}})),
		},
{{- end}}
	}
{{- if $name}}
	if name, ok := resp.Schema.Attributes[{{printf "%q" $name.Attr}}].(schema.StringAttribute); ok {
		name.Optional = true // and computed, as every copied attribute
		resp.Schema.Attributes[{{printf "%q" $name.Attr}}] = name
	}
{{- end}}
{{- else}}
	resp.Schema = utils.FrameworkDatasourceSchemaFromFrameworkResourceSchema(Schema())
{{- end}}
{{- range $.DataSource.Show}}
	// The data source shows the attributes of the items that the resource skips.
	if nested, ok := resp.Schema.Attributes[{{printf "%q" .Attr}}].(schema.{{.Collection}}NestedAttribute); ok {
{{- range .Fields}}
		nested.NestedObject.Attributes[{{printf "%q" .TFName}}] = schema.{{.Kind}}Attribute{
			Computed:            true,
			Description:         {{printf "%q" .Description}},
			MarkdownDescription: {{printf "%q" .Description}},
		}
{{- end}}
		resp.Schema.Attributes[{{printf "%q" .Attr}}] = nested
	}
{{- end}}
{{- if $.DataSource.Descriptions}}
	utils.OverrideDatasourceDescriptions(&resp.Schema, map[string]string{
{{- range $.DataSource.Descriptions}}
		{{printf "%q" .Path}}: {{printf "%q" .Text}},
{{- end}}
	})
{{- end}}
}

func (d *DataSource) Configure(_ context.Context, req datasource.ConfigureRequest, resp *datasource.ConfigureResponse) {
	if req.ProviderData == nil {
		return // The provider is not configured yet.
	}
	cs, ok := req.ProviderData.(*{{$provider}}.{{.ClientSet}})
	if !ok {
		resp.Diagnostics.AddError("Unexpected provider data",
			fmt.Sprintf("The provider data is %T. The data source needs *{{$provider}}.{{.ClientSet}}.", req.ProviderData))
		return
	}
	d.resource.client = cs.{{.Accessor}}()
}

{{if .Singleton -}}
// Read reads the singleton. A 404 is an error: the data source has no result to show.
{{- else if $name -}}
// Read reads the resource with the configured id, or with the id of the configured name. An id
// that the API does not find is an error. A 404 of a route that does not exist is an error too.
{{- else -}}
// Read reads the resource with the configured id. An id that the API does not find is an error.
// A 404 of a route that does not exist is an error too.
{{- end}}
func (d *DataSource) Read(ctx context.Context, req datasource.ReadRequest, resp *datasource.ReadResponse) {
	{{if and .Singleton $.DataSource.QueryID}}
	var configured types.String
	resp.Diagnostics.Append(req.Config.GetAttribute(ctx, path.Root("id"), &configured)...)
	if resp.Diagnostics.HasError() {
		return
	}
	id := TypeName
	var queryID *string
	if configured.IsUnknown() {
		resp.Diagnostics.AddError("Unknown singleton data source id", "The id must be known before the API read.")
		return
	}
	if !configured.IsNull() {
		id = configured.ValueString()
		queryID = &id
	}
	v, err := d.resource.getWithQueryID(ctx, queryID)
	{{else if .Singleton}}
	id := TypeName
	{{else}}
	var configured types.{{.IDTFType}}
	resp.Diagnostics.Append(req.Config.GetAttribute(ctx, path.Root({{printf "%q" .IDAttr}}), &configured)...)
{{- if $name}}
	var name types.String
	resp.Diagnostics.Append(req.Config.GetAttribute(ctx, path.Root({{printf "%q" $name.Attr}}), &name)...)
{{- end}}
	if resp.Diagnostics.HasError() {
		return
	}
	id := configured.Value{{.IDTFType}}()
{{- if $name}}
	if !name.IsNull() {
		var diags diag.Diagnostics
		if id, diags = d.idByName(ctx, name.ValueString()); diags.HasError() {
			resp.Diagnostics.Append(diags...)
			return
		}
	}
{{- end}}
{{- end}}
	{{if not (and .Singleton $.DataSource.QueryID)}}
	v, err := d.resource.get(ctx, id)
	{{end}}
	if {{$cx}}.{{.APINotFound}}(err) {
		resp.Diagnostics.AddError("coralogix_"+TypeName+" not found", fmt.Sprintf("The API did not find coralogix_%s with id %v: %s", TypeName, id, err))
		return
	}
	if err != nil {
		resp.Diagnostics.AddError("Unable to read coralogix_"+TypeName, fmt.Sprintf("id %v: %s", id, err))
		return
	}
{{- if .Existing}}
	if d.resource.hooks.BeforeFlatten != nil && v != nil {
		resp.Diagnostics.Append(d.resource.hooks.BeforeFlatten(ctx, v)...)
		if resp.Diagnostics.HasError() {
			return
		}
	}
{{- end}}
	m, diags := flatten(ctx, v{{if $.Conv.HasPrior}}, nil{{end}})
	resp.Diagnostics.Append(diags...)
	if resp.Diagnostics.HasError() {
		return
	}
{{- range $.DataSource.ValueFields}}
	// The data source shows the {{.TFName}} that the API returns, also an empty one, which the
	// resource reads as null.
{{- if .Value}}
	m.{{.Model}} = types.StringValue(v.{{.SDK}})
{{- else}}
	if v.{{.SDK}} != nil {
		m.{{.Model}} = types.StringValue(*v.{{.SDK}})
	}
{{- end}}
{{- end}}
{{- range $.DataSource.Show}}
	// A response without the {{.Attr}}, as proto3 omits an empty list, shows the empty one, not null.
	m.{{.Model}} = withShown{{.Model}}(ctx, v.{{.SDK}}, &resp.Diagnostics)
	if resp.Diagnostics.HasError() {
		return
	}
{{- end}}
{{- if and .Singleton .SingletonID}}
	if m.Id.IsNull() || m.Id.ValueString() == "" {
		m.Id = types.StringValue(TypeName) // the API returned no id
	}
{{- else if .Singleton}}
	m.Id = types.StringValue(SingletonID) // a singleton has a fixed id (D18)
{{- end}}
	resp.Diagnostics.Append(resp.State.Set(ctx, m)...)
}
{{- if $name}}

{{- if $name.First}}
// idByName lists the resources and returns the id of the first one with the name, in the order of
// the API, as the released data source did. A name that no item has is an error.
{{- else}}
// idByName lists the resources and returns the id of the one with the name. A name that no item
// has, or that more than one item has, is an error.
{{- end}}
func (d *DataSource) idByName(ctx context.Context, name string) ({{.IDGoType}}, diag.Diagnostics) {
	var diags diag.Diagnostics
	out, httpResp, err := d.resource.client.{{$name.List}}(ctx).Execute()
	if err != nil {
		diags.AddError("Unable to list coralogix_"+TypeName, {{$cx}}.{{.NewAPIError}}(httpResp, err).Error())
		return {{if eq .IDGoType "string"}}""{{else}}0{{end}}, diags
	}
	var ids []{{.IDGoType}}
	if out != nil {
		for _, item := range out.{{$name.Items}} {
{{- if $name.NameValue}}
			if item.{{$name.ItemName}} != name {
{{- else}}
			if item.{{$name.ItemName}} == nil || *item.{{$name.ItemName}} != name {
{{- end}}
				continue
			}
{{- if $name.IDValue}}
			ids = append(ids, item.{{$name.ItemID}})
{{- else}}
			if item.{{$name.ItemID}} != nil {
				ids = append(ids, *item.{{$name.ItemID}})
			}
{{- end}}
		}
	}
	if len(ids) == 0 {
		diags.AddError(fmt.Sprintf("coralogix_%s with name %q not found", TypeName, name), "")
		return {{if eq .IDGoType "string"}}""{{else}}0{{end}}, diags
	}
{{- if not $name.First}}
	if len(ids) > 1 {
		diags.AddError(fmt.Sprintf("coralogix_%s with name %q is not unique", TypeName, name),
			fmt.Sprintf("%d coralogix_%s resources have the name %q. Set the id instead of the name.", len(ids), TypeName, name))
		return {{if eq .IDGoType "string"}}""{{else}}0{{end}}, diags
	}
{{- end}}
	return ids[0], diags
}
{{- end}}
{{- range $.DataSource.Show}}

// withShown{{.Model}} converts the {{.Attr}} of the API with the attributes that only the data
// source has.
func withShown{{.Model}}(ctx context.Context, items []{{$.Conv.SDKName}}.{{.ItemSDK}}, diags *diag.Diagnostics) types.{{.Collection}} {
	attrTypes := {{.AttrTypes}}()
{{- range .Fields}}
	attrTypes[{{printf "%q" .TFName}}] = types.{{.Kind}}Type
{{- end}}
	elements := make([]attr.Value, 0, len(items))
	for i := range items {
		item := flatten{{.Flatten}}(ctx, path.Root({{printf "%q" .Attr}}), &items[i], {{if .NeedsPrior}}nil, {{end}}diags)
		value, valueDiags := types.ObjectValueFrom(ctx, {{.AttrTypes}}(), *item)
		diags.Append(valueDiags...)
		attributes := value.Attributes()
{{- range .Fields}}
{{- if .Pointer}}
		attributes[{{printf "%q" .TFName}}] = types.{{.Kind}}PointerValue(items[i].{{.SDK}})
{{- else}}
		attributes[{{printf "%q" .TFName}}] = types.{{.Kind}}Value(items[i].{{.SDK}})
{{- end}}
{{- end}}
		element, elementDiags := types.ObjectValue(attrTypes, attributes)
		diags.Append(elementDiags...)
		elements = append(elements, element)
	}
	out, outDiags := types.{{.Collection}}Value(types.ObjectType{AttrTypes: attrTypes}, elements)
	diags.Append(outDiags...)
	return out
}
{{- end}}
{{- end}}
