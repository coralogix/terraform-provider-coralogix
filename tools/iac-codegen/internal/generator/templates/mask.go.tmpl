{{with .Conv}}
// tfData is a tfsdk.Config, tfsdk.Plan, or tfsdk.State.
type tfData interface {
	Get(ctx context.Context, target interface{}) diag.Diagnostics
	GetAttribute(ctx context.Context, p path.Path, target interface{}) diag.Diagnostics
}

{{- if .LeafMask}}
// maskNode is an Update field, or a field below one. children are the fields
// of an object or the arms of a oneOf. A node without children is compared
// as a whole: a scalar, a list, a set, a map, or an object with no fields.
type maskNode struct {
	attr, api     string
	oneOf         bool
	serverDefault bool
	children      []*maskNode
	groups        [][]string // oneOf groups among children, by attr
}
{{- if .HasGroups}}

func (n *maskNode) names() (string, string) { return n.attr, n.api }
{{- end}}

// maskFields are the Update fields, in model order.
var maskFields = []*maskNode{
{{- range .MaskFields}}
	{{template "maskNode" .}},
{{- end}}
}

// updateMask returns the paths of the values that differ in the plan and in
// the state. The spec pattern accepts nested paths, so a change inside an
// object names the changed leaf (contract 2.1), for example "a.b.c". A list,
// a set, or a map is replaced whole (2.2). A new oneOf arm names the arm; a
// removed oneOf names the old arm with no value (2.6, 2.7). A value that the
// plan clears (null) is in the mask. Expand leaves it out of the body, so the
// server clears it. It uses Terraform equality, so Set order does not matter.
func updateMask(ctx context.Context, config, plan, state tfData) ([]string, diag.Diagnostics) {
	var diags diag.Diagnostics
	var mask []string
{{- if .HasGroups}}
	planValues, stateValues := map[string]attr.Value{}, map[string]attr.Value{}
{{- end}}
	for _, f := range maskFields {
		var c, p, s attr.Value
		var fieldDiags diag.Diagnostics
		fieldDiags.Append(config.GetAttribute(ctx, path.Root(f.attr), &c)...)
		fieldDiags.Append(plan.GetAttribute(ctx, path.Root(f.attr), &p)...)
		fieldDiags.Append(state.GetAttribute(ctx, path.Root(f.attr), &s)...)
		diags.Append(fieldDiags...)
		if fieldDiags.HasError() {
			continue
		}
{{- if $.ServerPaths}}
		p, s = requestValue(ctx, f.attr, p, &diags), requestValue(ctx, f.attr, s, &diags)
{{- end}}
		validateRequestValue(path.Root(f.attr), c, p, f.serverDefault, &diags)
		mask = maskPaths(mask, "", f, p, s)
{{- if .HasGroups}}
		planValues[f.attr], stateValues[f.attr] = p, s
{{- end}}
	}
{{- if .HasGroups}}
	mask = dropSwitchedArms(mask, "", maskFields, maskGroups, planValues, stateValues)
{{- end}}
	return mask, diags
}

// maskPaths adds the paths of the values below n that differ in p and s.
func maskPaths(mask []string, prefix string, n *maskNode, p, s attr.Value) []string {
	if p.Equal(s) {
		return mask
	}
	at := n.api
	if prefix != "" {
		at = prefix + "." + n.api
	}
	po, pok := p.(types.Object)
	so, sok := s.(types.Object)
	switch {
	case n.children == nil || !pok || !sok:
		return append(mask, at)
	case n.oneOf:
		return oneOfPaths(mask, at, n, po, so)
	case po.IsNull() || po.IsUnknown() || so.IsNull():
		return append(mask, at)
	}
	pa, sa := po.Attributes(), so.Attributes()
	for _, c := range n.children {
		mask = maskPaths(mask, at, c, pa[c.attr], sa[c.attr])
	}
{{- if .HasGroups}}
	mask = dropSwitchedArms(mask, at, n.children, n.groups, pa, sa)
{{- end}}
	return mask
}

// oneOfPaths adds the paths of a oneOf at path at that differs in po and so.
func oneOfPaths(mask []string, at string, n *maskNode, po, so types.Object) []string {
	pArm, sArm := activeArm(n, po), activeArm(n, so)
	switch {
	case pArm == nil && sArm == nil:
		return mask
	case pArm == nil:
		return append(mask, at+"."+sArm.api) // clear: the old arm, no value
	case sArm == nil || pArm != sArm:
		return append(mask, at+"."+pArm.api) // a new arm replaces the old one
	}
	return maskPaths(mask, at, pArm, po.Attributes()[pArm.attr], so.Attributes()[pArm.attr])
}

// activeArm returns the arm of the oneOf n that o sets, or nil.
func activeArm(n *maskNode, o types.Object) *maskNode {
	if o.IsNull() || o.IsUnknown() {
		return nil
	}
	a := o.Attributes()
	for _, c := range n.children {
		if v, ok := a[c.attr]; ok && !v.IsNull() {
			return c
		}
	}
	return nil
}
{{- else}}
// maskFields are the Update fields, in model order: the Terraform attribute
// and the API name in the update mask.
{{- if .HasGroups}}
type maskField struct {
	attr, api     string
	serverDefault bool
}

func (f maskField) names() (string, string) { return f.attr, f.api }

var maskFields = []maskField{
{{- else}}
var maskFields = []struct {
	attr, api     string
	serverDefault bool
}{
{{- end}}
{{- range .MaskFields}}
	{attr: {{printf "%q" .TFName}}, api: {{printf "%q" .API}}, serverDefault: {{.ServerDefault}}},
{{- end}}
}

// updateMask returns the API names of the Update fields that have a
// different value in the plan and in the state. It uses Terraform equality,
// so the order of a Set does not matter. A field that the plan clears (null)
// is in the mask. Expand leaves it out of the body, so the server clears it.
// A change inside a field puts the whole field in the mask. The server
// replaces the whole value.
func updateMask(ctx context.Context, config, plan, state tfData) ([]string, diag.Diagnostics) {
	var diags diag.Diagnostics
	var mask []string
{{- if .HasGroups}}
	planValues, stateValues := map[string]attr.Value{}, map[string]attr.Value{}
{{- end}}
	for _, f := range maskFields {
		var c, p, s attr.Value
		var fieldDiags diag.Diagnostics
		fieldDiags.Append(config.GetAttribute(ctx, path.Root(f.attr), &c)...)
		fieldDiags.Append(plan.GetAttribute(ctx, path.Root(f.attr), &p)...)
		fieldDiags.Append(state.GetAttribute(ctx, path.Root(f.attr), &s)...)
		diags.Append(fieldDiags...)
		if fieldDiags.HasError() {
			continue
		}
{{- if $.ServerPaths}}
		p, s = requestValue(ctx, f.attr, p, &diags), requestValue(ctx, f.attr, s, &diags)
{{- end}}
		validateRequestValue(path.Root(f.attr), c, p, f.serverDefault, &diags)
		if !p.Equal(s) {
			mask = append(mask, f.api)
		}
{{- if .HasGroups}}
		planValues[f.attr], stateValues[f.attr] = p, s
{{- end}}
	}
{{- if .HasGroups}}
	mask = dropSwitchedArms(mask, "", maskFields, maskGroups, planValues, stateValues)
{{- end}}
	return mask, diags
}
{{- end}}

{{- if .HasGroups}}

// maskGroups are the oneOf groups among the Update fields, by attr.
var maskGroups = [][]string{
{{- range .MaskGroups}}
	{ {{- range $i, $a := .}}{{if $i}}, {{end}}{{printf "%q" $a}}{{end -}} },
{{- end}}
}

// dropSwitchedArms removes the old arm of each oneOf group that changed to
// another arm: the mask names only the new arm, and the server replaces the
// old one (contract 2.6). A removed oneOf keeps the old arm (2.7).
func dropSwitchedArms[F interface{ names() (string, string) }](mask []string, prefix string, fields []F, groups [][]string, p, s map[string]attr.Value) []string {
	api := map[string]string{}
	for _, f := range fields {
		a, n := f.names()
		api[a] = n
	}
	for _, g := range groups {
		pArm, sArm := setArm(g, p), setArm(g, s)
		if pArm == "" || sArm == "" || pArm == sArm {
			continue
		}
		old := api[sArm]
		if prefix != "" {
			old = prefix + "." + old
		}
		mask = slices.DeleteFunc(mask, func(m string) bool { return m == old })
	}
	return mask
}

// setArm returns the arm of group g that v sets, or "".
func setArm(g []string, v map[string]attr.Value) string {
	for _, a := range g {
		if x, ok := v[a]; ok && x != nil && !x.IsNull() {
			return a
		}
	}
	return ""
}
{{- end}}

{{- if .OmitUpdateMask}}
// updateRequest returns the Update body with only the fields that changed.
// An omitted mask updates every field present in the body, so an unchanged
// field is left unset. A field cleared to null is absent from JSON, so the
// body then includes updateMask and the server clears it. updateRequest
// returns nil when no Update field changed. Then the caller sends no request.
func updateRequest(ctx context.Context, config, plan, state tfData) (*{{.SDKName}}.{{.UpdateBody}}, diag.Diagnostics) {
	mask, diags := updateMask(ctx, config, plan, state)
	if diags.HasError() || len(mask) == 0 {
		return nil, diags
	}
	var m {{.Update.Model}}
	diags.Append(plan.Get(ctx, &m)...)
	if diags.HasError() {
		return nil, diags
	}
	body, d := expandUpdate(ctx, &m)
	diags.Append(d...)
	if diags.HasError() {
		return nil, diags
	}
	keepChanged(body, mask)
	return body, diags
}

// keepChanged clears each nillable Update field whose top-level name is not
// in mask. A changed field that is null cannot be omitted: the body then sets
// updateMask so the server clears it. A Go value cannot be cleared, so it
// stays in the body.
func keepChanged(body *{{.SDKName}}.{{.UpdateBody}}, mask []string) {
	if body == nil || len(mask) == 0 {
		return
	}
	{{- if .HasNillableUpdate}}
	keep := map[string]bool{}
	for _, path := range mask {
		top, _, _ := strings.Cut(path, ".")
		keep[top] = true
	}
	{{- if .UpdateWrap}}
	{{- if .UpdateWrap.Value}}
	target := &body.{{.UpdateWrap.Field}}
	{{- else}}
	target := body.{{.UpdateWrap.Field}}
	if target == nil {
		return
	}
	{{- end}}
	{{- else}}
	target := body
	{{- end}}
	cleared := false
	{{- range .MaskFields}}
	{{- if .Nillable}}
	if !keep[{{printf "%q" .API}}] {
		target.{{.SDK}} = nil
	} else if target.{{.SDK}} == nil {
		cleared = true
	}
	{{- end}}
	{{- end}}
	if cleared {
		text := strings.Join(mask, ",")
		{{- if .UpdateMaskPointer}}
		body.{{.UpdateMaskField}} = &text
		{{- else}}
		body.{{.UpdateMaskField}} = text
		{{- end}}
	}
	{{- end}}
}
{{- else}}
// updateRequest returns the Update body and updateMask query parameter. The
// body has every Update field. The server does not change a field that is not
// in the mask. updateRequest returns nil when no Update field changed. Then
// the caller sends no request: the mask cannot be empty, and it is never "*".
func updateRequest(ctx context.Context, config, plan, state tfData) (*{{.SDKName}}.{{.Update.SDK}}, string, diag.Diagnostics) {
	mask, diags := updateMask(ctx, config, plan, state)
	if diags.HasError() || len(mask) == 0 {
		return nil, "", diags
	}
	var m {{.Update.Model}}
	diags.Append(plan.Get(ctx, &m)...)
	if diags.HasError() {
		return nil, "", diags
	}
	body, d := expandUpdate(ctx, &m)
	diags.Append(d...)
	if diags.HasError() {
		return nil, "", diags
	}
	return body, strings.Join(mask, ","), diags
}
{{- end}}
{{- end}}

{{- define "maskNode" -}}
{attr: {{printf "%q" .TFName}}, api: {{printf "%q" .API}}, serverDefault: {{.ServerDefault}}
{{- if .OneOf}}, oneOf: true{{end}}
{{- if .Groups}}, groups: [][]string{ {{- range $gi, $g := .Groups}}{{if $gi}}, {{end}}{ {{- range $i, $a := $g}}{{if $i}}, {{end}}{{printf "%q" $a}}{{end -}} }{{end -}} }{{end}}
{{- if .Children}}, children: []*maskNode{
{{- range .Children}}
	{{template "maskNode" .}},
{{- end}}
}{{end -}}
}
{{- end}}
