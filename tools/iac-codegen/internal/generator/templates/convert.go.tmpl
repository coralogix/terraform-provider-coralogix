// flatten returns the Terraform model of the resource in an API response.
// A value that the response does not have is null.
func flatten(ctx context.Context, v *{{$sdk}}.{{.Resource.SDK}}{{if .HasPrior}}, prior *{{.Resource.Model}}{{end}}) (*{{.Resource.Model}}, diag.Diagnostics) {
	var diags diag.Diagnostics
	if v == nil {
		diags.AddError("Missing resource", "The API response has no {{.Resource.SDK}}.")
		return nil, diags
	}
{{- range .RootUnsupported}}
	if v.{{.SDK}} != nil {
		diags.AddError({{printf "%q" .Summary}}, {{printf "%q" .Detail}})
		return nil, diags
	}
{{- end}}
{{- range .Arms}}
	if v.{{.SDK}} == nil {
		// The top-level attributes are fields of this object, so a response without it has no resource.
		diags.AddError("Missing resource", "The API response has no {{.API}}.")
		return nil, diags
	}
{{- end}}
	out := flatten{{.Resource.Func}}(ctx, path.Empty(), v, {{if .HasPrior}}prior, {{end}}&diags)
{{- if .IDGuard}}
	if out.{{.IDGuard}}.IsNull(){{if .IDString}} || out.{{.IDGuard}}.ValueString() == ""{{end}} {
		diags.AddError("Missing id", "The API response has no id. Without it, Terraform cannot read, update, or delete the resource.")
	}
{{- end}}
	return out, diags
}

