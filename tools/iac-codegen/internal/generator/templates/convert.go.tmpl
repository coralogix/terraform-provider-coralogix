// flattenFloat64AsFloat32 returns a double that the API stores as a float32 as the shortest
// decimal of that float32: 0.30000001192092896 reads back as 0.3, as the configuration has it.
func flattenFloat64AsFloat32(v *float64) types.Float64 {
	if v == nil {
		return types.Float64Null()
	}
	f, err := strconv.ParseFloat(strconv.FormatFloat(float64(float32(*v)), 'g', -1, 32), 64)
	if err != nil {
