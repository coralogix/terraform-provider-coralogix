	{{- end}}
	if {{if .ReadEmptyAsNull}}len({{$src}}) != 0{{else}}{{$src}} != nil{{end}} {
		items := make([]{{.Object.Model}}, 0, len({{$src}}))
		{{- if .Object.NeedsPrior}}
		var prior{{.Model}} []{{.Object.Model}}
		if prior != nil {
			prior{{.Model}} = priorItems[{{.Object.Model}}](ctx, prior.{{.Model}})
