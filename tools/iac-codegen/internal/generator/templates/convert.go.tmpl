{{- define "expandField"}}
{{- $p := printf "p.AtName(%q)" .TFName}}
{{- $l := ""}}{{$r := ""}}{{if .Value}}{{$l = "valueOf("}}{{$r = ")"}}{{end}}
{{- if eq .Conv "string"}}
	out.{{.SDK}} = {{$l}}expandString(m.{{.Model}}){{$r}}
{{- else if eq .Conv "bool"}}
	out.{{.SDK}} = {{$l}}expandBool(m.{{.Model}}){{$r}}
{{- else if eq .Conv "float64"}}
	out.{{.SDK}} = {{$l}}expandFloat64(m.{{.Model}}){{$r}}
{{- else if eq .Conv "int32"}}
	out.{{.SDK}} = {{$l}}expandInt32(m.{{.Model}}){{$r}}
{{- else if eq .Conv "int64"}}
	out.{{.SDK}} = {{$l}}expandInt64(m.{{.Model}}){{$r}}
{{- else if eq .Conv "float32"}}
	out.{{.SDK}} = {{$l}}expandFloat32(m.{{.Model}}){{$r}}
{{- else if eq .Conv "scalars"}}
	{{- if eq .Collection "Set"}}
	out.{{.SDK}} = expandSet[{{.SDKType}}](ctx, {{$p}}, m.{{.Model}}, diags)
	{{- else}}
	out.{{.SDK}} = expandElements[{{.SDKType}}](ctx, {{$p}}, m.{{.Model}}, diags)
	{{- end}}
{{- else if eq .Conv "scalarmap"}}
	out.{{.SDK}} = expandMap[{{.SDKType}}](ctx, {{$p}}, m.{{.Model}}, diags)
{{- else if eq .Conv "uint64"}}
	out.{{.SDK}} = {{$l}}expandUint64({{$p}}, m.{{.Model}}, diags){{$r}}
{{- else if and (eq .Conv "enum") .EnumMap}}
	out.{{.SDK}} = {{$l}}expandEnumMapped({{$p}}, m.{{.Model}}, {{.EnumMap.Name}}ToAPI, diags){{$r}}
{{- else if eq .Conv "enum"}}
	out.{{.SDK}} = {{$l}}expandEnum[{{.SDKType}}](m.{{.Model}}){{$r}}
{{- else if eq .Conv "object"}}
	out.{{.SDK}} = {{$l}}expand{{.Object.Func}}(ctx, {{$p}}, m.{{.Model}}, diags){{$r}}
{{- else if eq .Conv "empty"}}
	if m.{{.Model}} != nil {
		out.{{.SDK}} = map[string]interface{}{}
	}
{{- else if eq .Conv "strings"}}
	{{- if eq .Collection "Set"}}
	out.{{.SDK}} = expandStringsSet[{{.SDKType}}](ctx, {{$p}}, m.{{.Model}}, diags)
	{{- else}}
	out.{{.SDK}} = expandStrings[{{.SDKType}}](ctx, {{$p}}, m.{{.Model}}, diags)
	{{- end}}
{{- else if eq .Conv "stringmap"}}
	out.{{.SDK}} = expandStringMap[{{.SDKType}}](ctx, {{$p}}, m.{{.Model}}, diags)
{{- else if eq .Conv "uint64map"}}
	out.{{.SDK}} = expandUint64Map(ctx, {{$p}}, m.{{.Model}}, diags)
{{- else if eq .Conv "objectmap"}}
	if items := expandMap[{{.Object.Model}}](ctx, {{$p}}, m.{{.Model}}, diags); items != nil {
		out.{{.SDK}} = make(map[string]{{.SDKType}}, len(items))
		for k := range items {
			item := items[k]
			out.{{.SDK}}[k] = *expand{{.Object.Func}}(ctx, {{$p}}.AtMapKey(k), &item, diags)
		}
	}
{{- else if eq .Conv "objects"}}
	if items := expandElements[{{.Object.Model}}](ctx, {{$p}}, m.{{.Model}}, diags); items != nil {
		out.{{.SDK}} = make([]{{.SDKType}}, 0, len(items))
		for i := range items {
			{{- if eq .Collection "Set"}}
			out.{{.SDK}} = append(out.{{.SDK}}, *expand{{.Object.Func}}(ctx, {{$p}}, &items[i], diags))
			{{- else}}
			out.{{.SDK}} = append(out.{{.SDK}}, *expand{{.Object.Func}}(ctx, {{$p}}.AtListIndex(i), &items[i], diags))
			{{- end}}
		}
	}
{{- end}}
{{- end}}

{{- define "flattenField"}}
{{- $p := printf "p.AtName(%q)" .TFName}}
{{- $v := printf "v.%s" .SDK}}{{if .Value}}{{$v = printf "&v.%s" .SDK}}{{end}}
{{- if eq .Conv "string"}}
	out.{{.Model}} = types.StringPointerValue({{$v}})
	{{- if .Equality}}
	if prior != nil {
		out.{{.Model}} = keepEquivalentText(prior.{{.Model}}, out.{{.Model}}, {{.Equality}}Equal)
	}
	{{- end}}
{{- else if eq .Conv "bool"}}
	out.{{.Model}} = types.BoolPointerValue({{$v}})
{{- else if eq .Conv "float64"}}
	out.{{.Model}} = types.Float64PointerValue({{$v}})
{{- else if eq .Conv "int32"}}
	out.{{.Model}} = types.Int32PointerValue({{$v}})
{{- else if eq .Conv "int64"}}
	out.{{.Model}} = types.Int64PointerValue({{$v}})
{{- else if eq .Conv "float32"}}
	out.{{.Model}} = types.Float32PointerValue({{$v}})
{{- else if eq .Conv "scalars"}}
	out.{{.Model}} = flattenScalars{{.Collection}}(ctx, {{.ElemType}}, v.{{.SDK}}, diags)
{{- else if eq .Conv "scalarmap"}}
	out.{{.Model}} = flattenScalarMap(ctx, {{.ElemType}}, v.{{.SDK}}, diags)
{{- else if eq .Conv "uint64"}}
	out.{{.Model}} = flattenUint64({{$p}}, {{$v}}, diags)
{{- else if eq .Conv "time"}}
	out.{{.Model}} = flattenTime({{$v}})
{{- else if and (eq .Conv "enum") .EnumMap}}
	out.{{.Model}} = flattenEnumMapped({{$p}}, {{$v}}, {{.EnumMap.Name}}FromAPI, diags)
{{- else if eq .Conv "enum"}}
	out.{{.Model}} = flattenEnum({{$v}}, {{printf "%q" .EnumZero}})
{{- else if eq .Conv "object"}}
	{{- if .ObjectValue}}
	out.{{.Model}} = types.ObjectNull({{.Object.AttrTypesFunc}}())
	if nested := flatten{{.Object.Func}}(ctx, {{$p}}, {{$v}}, diags); nested != nil {
		value, valueDiags := types.ObjectValueFrom(ctx, {{.Object.AttrTypesFunc}}(), *nested)
		diags.Append(valueDiags...)
		out.{{.Model}} = value
	}
	{{- else}}
	{{- if .Object.NeedsPrior}}
	var prior{{.Model}} *{{.Object.Model}}
	if prior != nil {
		prior{{.Model}} = prior.{{.Model}}
	}
	out.{{.Model}} = flatten{{.Object.Func}}(ctx, {{$p}}, {{$v}}, prior{{.Model}}, diags)
	{{- else}}
	out.{{.Model}} = flatten{{.Object.Func}}(ctx, {{$p}}, {{$v}}, diags)
	{{- end}}
	{{- if .ReadEmptyAsNull}}
	if out.{{.Model}} != nil && reflect.DeepEqual(*out.{{.Model}}, {{.Object.Model}}{}) {
		out.{{.Model}} = nil
	}
	{{- end}}
	{{- end}}
{{- else if eq .Conv "empty"}}
	{{- if .ObjectValue}}
	out.{{.Model}} = types.ObjectNull(map[string]attr.Type{})
	if v.{{.SDK}} != nil {
		value, valueDiags := types.ObjectValue(map[string]attr.Type{}, map[string]attr.Value{})
		diags.Append(valueDiags...)
		out.{{.Model}} = value
	}
	{{- else}}
	if v.{{.SDK}} != nil {
		out.{{.Model}} = &{{.Object.Model}}{}
	}
	{{- end}}
{{- else if eq .Conv "strings"}}
	{{- if .Enum}}
	out.{{.Model}} = flattenEnums{{.Collection}}(ctx, {{$p}}, v.{{.SDK}}, {{printf "%q" .EnumZero}}, diags)
	{{- else}}
	out.{{.Model}} = flattenStrings{{.Collection}}(ctx, v.{{.SDK}}, diags)
	{{- end}}
{{- else if eq .Conv "stringmap"}}
	{{- if .Enum}}
	out.{{.Model}} = flattenEnumMap(ctx, {{$p}}, v.{{.SDK}}, {{printf "%q" .EnumZero}}, diags)
	{{- else}}
	out.{{.Model}} = flattenStringMap(ctx, v.{{.SDK}}, diags)
	{{- end}}
{{- else if eq .Conv "uint64map"}}
	out.{{.Model}} = flattenUint64Map(ctx, {{$p}}, v.{{.SDK}}, diags)
{{- else if eq .Conv "objectmap"}}
	out.{{.Model}} = types.MapNull(types.ObjectType{AttrTypes: {{.Object.AttrTypesFunc}}()})
	if v.{{.SDK}} != nil {
		items := make(map[string]{{.Object.Model}}, len(v.{{.SDK}}))
		for k := range v.{{.SDK}} {
			item := v.{{.SDK}}[k]
			items[k] = *flatten{{.Object.Func}}(ctx, {{$p}}.AtMapKey(k), &item, diags)
		}
		out.{{.Model}} = flattenMap(ctx, types.ObjectType{AttrTypes: {{.Object.AttrTypesFunc}}()}, items, diags)
	}
{{- else if eq .Conv "objects"}}
	{{- $src := printf "v.%s" .SDK}}{{if .KeepPriorOrder}}{{$src = printf "src%s" .Model}}{{end}}
	out.{{.Model}} = types.{{.Collection}}Null(types.ObjectType{AttrTypes: {{.Object.AttrTypesFunc}}()})
	{{- if .KeepPriorOrder}}
	{{$src}} := v.{{.SDK}}
	if prior != nil {
		{{- if .PriorVia}}
		flattenItem := func(ctx context.Context, v *{{.SDKType}}, diags *diag.Diagnostics) *{{.Object.Model}} {
			return flatten{{.Object.Func}}(ctx, path.Empty(), v, {{if .Object.NeedsPrior}}nil, {{end}}diags)
		}
		{{$src}} = keepOrderVia(ctx, {{$src}}, prior.{{.Model}}, flattenItem, expand{{.PriorVia.Func}}, same{{.PriorVia.Func}})
		{{- else}}
		{{$src}} = keepOrder(ctx, {{$src}}, prior.{{.Model}}, expand{{.Object.Func}}, same{{.Object.Func}})
		{{- end}}
	}
	{{- end}}
	if {{if .ReadEmptyAsNull}}len({{$src}}) != 0{{else}}{{$src}} != nil{{end}} {
		items := make([]{{.Object.Model}}, 0, len({{$src}}))
		{{- if .Object.NeedsPrior}}
		var prior{{.Model}} []{{.Object.Model}}
		if prior != nil {
			prior{{.Model}} = priorItems[{{.Object.Model}}](ctx, prior.{{.Model}})
		}
		{{- end}}
		for i := range {{$src}} {
			{{- if eq .Collection "Set"}}
			{{- if .Object.NeedsPrior}}
			items = append(items, *flatten{{.Object.Func}}(ctx, {{$p}}, &{{$src}}[i], nil, diags))
			{{- else}}
			items = append(items, *flatten{{.Object.Func}}(ctx, {{$p}}, &{{$src}}[i], diags))
			{{- end}}
			{{- else}}
			{{- if .Object.NeedsPrior}}
			// The prior item at the same index keeps the order of its own lists and the text of its documents.
			var priorItem *{{.Object.Model}}
			if i < len(prior{{.Model}}) {
				priorItem = &prior{{.Model}}[i]
			}
			items = append(items, *flatten{{.Object.Func}}(ctx, {{$p}}.AtListIndex(i), &{{$src}}[i], priorItem, diags))
			{{- else}}
			items = append(items, *flatten{{.Object.Func}}(ctx, {{$p}}.AtListIndex(i), &{{$src}}[i], diags))
			{{- end}}
			{{- end}}
		}
		out.{{.Model}} = flatten{{.Collection}}(ctx, types.ObjectType{AttrTypes: {{.Object.AttrTypesFunc}}()}, items, diags)
	}
{{- end}}
{{- end}}
