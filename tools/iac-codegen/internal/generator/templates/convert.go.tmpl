func validateCreate(ctx context.Context, config, plan tfData) diag.Diagnostics {
	var diags diag.Diagnostics
	for _, field := range createFields {
		var c, p attr.Value
		var fieldDiags diag.Diagnostics
		fieldDiags.Append(config.GetAttribute(ctx, path.Root(field.attr), &c)...)
		fieldDiags.Append(plan.GetAttribute(ctx, path.Root(field.attr), &p)...)
		diags.Append(fieldDiags...)
		if fieldDiags.HasError() {
			continue
		}
{{- if $.RequestFilter}}
		p = requestValue(ctx, field.attr, p, &diags)
{{- end}}
		validateRequestValue(path.Root(field.attr), c, p, field.serverDefault, &diags)
	}
	return diags
}
