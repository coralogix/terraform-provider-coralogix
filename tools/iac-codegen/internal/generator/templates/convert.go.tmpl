// oneOfArms are the paths of the oneOf arms, with list and map steps left
// out. An empty arm selects that arm, so it is not the same as a missing arm
// (contract 2.8).
var oneOfArms = map[string]bool{
{{- range .OneOfArms}}
	{{printf "%q" .}}: true,
{{- end}}
}

