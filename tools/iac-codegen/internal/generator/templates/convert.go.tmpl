	b := v.ValueBool()
	return &b
}
{{- if .Conv.Uses "split"}}

// joinStrings returns the elements of a set of strings joined by sep, as the API holds them, or nil
// for a null or unknown set.
func joinStrings(ctx context.Context, p path.Path, v types.Set, sep string, diags *diag.Diagnostics) *string {
	if v.IsNull() || v.IsUnknown() {
		return nil
	}
	var values []string
	diags.Append(v.ElementsAs(ctx, &values, false)...)
	joined := strings.Join(values, sep)
	return &joined
}

// splitStrings returns the values that the API holds joined by sep as a set of strings, or a null
// set when the API has none.
func splitStrings(v *string, sep string) types.Set {
	if v == nil {
		return types.SetNull(types.StringType)
	}
	elems := []attr.Value{}
	if *v == "" {
		// joinStrings sends an empty set as "": it reads back empty, not as one empty element.
		return types.SetValueMust(types.StringType, elems)
	}
	for _, s := range strings.Split(*v, sep) {
		elems = append(elems, types.StringValue(s))
	}
	return types.SetValueMust(types.StringType, elems)
}
{{- end}}
