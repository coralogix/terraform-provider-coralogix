// expandUint64 returns the decimal string of v. The API sends 64-bit
// numbers as strings.
func expandUint64(p path.Path, v types.Int64, diags *diag.Diagnostics) *string {
	if v.IsNull() || v.IsUnknown() {
		return nil
	}
	n := v.ValueInt64()
	if n < 0 {
		diags.AddAttributeError(p, "Invalid value", fmt.Sprintf("The value %d is negative. The API accepts only unsigned numbers.", n))
		return nil
	}
	s := strconv.FormatInt(n, 10)
	return &s
}

// flattenUint64 parses the decimal string of an unsigned 64-bit number. A
// value larger than the Terraform Int64 maximum is an error.
func flattenUint64(p path.Path, v *string, diags *diag.Diagnostics) types.Int64 {
	if v == nil {
		return types.Int64Null()
	}
	n, err := strconv.ParseUint(*v, 10, 64)
	if err != nil {
		diags.AddAttributeError(p, "Invalid API value", fmt.Sprintf("The API returned %q, which is not an unsigned number: %s", *v, err))
		return types.Int64Null()
	}
	if n > math.MaxInt64 {
		diags.AddAttributeError(p, "Invalid API value", fmt.Sprintf("The API returned %d, which is larger than the Terraform maximum %d.", n, int64(math.MaxInt64)))
		return types.Int64Null()
	}
	return types.Int64Value(int64(n))
}

