// distributed{{.Name}} holds the {{.Name}} list of one request or one response. The list is no
// attribute of the resource: each item of it is an attribute of the object that it names. Expand
// collects the items of every object, and flatten gives each object the items that name it.
type distributed{{.Name}} struct {
	items []{{.SDKType}}
}

type distributed{{.Name}}Key struct{}

// withDistributed{{.Name}} returns ctx with a new collector that holds items.
func withDistributed{{.Name}}(ctx context.Context, items []{{.SDKType}}) (context.Context, *distributed{{.Name}}) {
	d := &distributed{{.Name}}{items: items}
	return context.WithValue(ctx, distributed{{.Name}}Key{}, d), d
}

// distributed{{.Name}}Of returns the collector of ctx, or nil when ctx has none.
func distributed{{.Name}}Of(ctx context.Context) *distributed{{.Name}} {
	d, _ := ctx.Value(distributed{{.Name}}Key{}).(*distributed{{.Name}})
	return d
}

// of returns the items that name the object with the id, in the order of the list.
func (d *distributed{{.Name}}) of(id string) []{{.SDKType}} {
	var out []{{.SDKType}}
	for _, a := range d.items {
{{- if .Keep}}
		if !({{.Keep}}) {
			continue
		}
{{- end}}
		if got := {{.ListRead}}; got != nil && *got == id {
			out = append(out, a)
		}
	}
	return out
}
