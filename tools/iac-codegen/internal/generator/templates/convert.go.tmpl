// elements is a types.Set or a types.List.
type elements interface {
	IsNull() bool
	IsUnknown() bool
	ElementsAs(ctx context.Context, target interface{}, allowUnhandled bool) diag.Diagnostics
}

// expandElements returns the elements of v. It returns nil for a null
// value, and a non-nil slice for an empty value.
func expandElements[T any](ctx context.Context, p path.Path, v elements, diags *diag.Diagnostics) []T {
	if v.IsNull() || v.IsUnknown() {
		return nil
	}
	out := []T{}
	for _, d := range v.ElementsAs(ctx, &out, false) {
		diags.Append(diag.WithPath(p, d))
	}
	if out == nil {
		out = []T{}
	}
	return out
}

func expandStrings[T ~string](ctx context.Context, p path.Path, v elements, diags *diag.Diagnostics) []T {
	items := expandElements[string](ctx, p, v, diags)
	if items == nil {
		return nil
	}
	out := make([]T, 0, len(items))
	for _, s := range items {
		out = append(out, T(s))
	}
	return out
}

// expandStringsSet preserves null and empty, and removes duplicate wire values.
func expandStringsSet[T ~string](ctx context.Context, p path.Path, v elements, diags *diag.Diagnostics) []T {
	items := expandStrings[T](ctx, p, v, diags)
	if items == nil {
		return nil
	}
	out := make([]T, 0, len(items))
	seen := make(map[T]struct{}, len(items))
	for _, item := range items {
		if _, ok := seen[item]; ok {
			continue
		}
		seen[item] = struct{}{}
		out = append(out, item)
	}
	return out
}

// expandSet preserves null and empty, and removes duplicate scalar values.
func expandSet[T comparable](ctx context.Context, p path.Path, v elements, diags *diag.Diagnostics) []T {
	items := expandElements[T](ctx, p, v, diags)
	if items == nil {
		return nil
	}
	out := make([]T, 0, len(items))
	seen := make(map[T]struct{}, len(items))
	for _, item := range items {
		if _, ok := seen[item]; ok {
			continue
		}
		seen[item] = struct{}{}
		out = append(out, item)
	}
	return out
}

func expandString(v types.String) *string {
	if v.IsNull() || v.IsUnknown() {
		return nil
	}
	s := v.ValueString()
	return &s
}

func expandBool(v types.Bool) *bool {
	if v.IsNull() || v.IsUnknown() {
		return nil
