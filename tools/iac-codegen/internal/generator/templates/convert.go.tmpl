// validateRequestValue accepts every planned value. An unknown value of a computed attribute is
// left out of the request, and the server supplies it, as the released resource did.
func validateRequestValue(_ path.Path, _, _ attr.Value, _ bool, _ *diag.Diagnostics) {}
{{- else}}
// validateRequestValue prevents an unknown planned value from becoming an
// omitted API value. The only safe exception is an unknown value created by
// removal of a field with a declared server default.
func validateRequestValue(p path.Path, config, plan attr.Value, serverDefault bool, diags *diag.Diagnostics) {
	unknown := unknownValuePaths(p, plan)
	if len(unknown) == 0 {
		return
	}
	if serverDefault && config != nil && config.IsNull() && plan.IsUnknown() {
		return
	}
	for _, at := range unknown {
		diags.AddAttributeError(at, "Unknown value before API call", "Terraform could not determine this value before the API call. Apply again after its dependencies are known.")
	}
}
{{- end}}

var createFields = []struct {
	attr          string
	serverDefault bool
}{
{{- range .CreateFields}}
	{attr: {{printf "%q" .TFName}}, serverDefault: {{.ServerDefault}}},
{{- end}}
}

func validateCreate(ctx context.Context, config, plan tfData) diag.Diagnostics {
	var diags diag.Diagnostics
	for _, field := range createFields {
		var c, p attr.Value
		var fieldDiags diag.Diagnostics
		fieldDiags.Append(config.GetAttribute(ctx, path.Root(field.attr), &c)...)
		fieldDiags.Append(plan.GetAttribute(ctx, path.Root(field.attr), &p)...)
		diags.Append(fieldDiags...)
		if fieldDiags.HasError() {
			continue
		}
{{- if $.ServerPaths}}
		p = requestValue(ctx, field.attr, p, &diags)
{{- end}}
		validateRequestValue(path.Root(field.attr), c, p, field.serverDefault, &diags)
	}
	return diags
}
{{- if $.ServerPaths}}

// serverAttrs are the paths of the computed attributes inside the values
// that a request sends, with list and map steps left out. The server sets
// them.
var serverAttrs = map[string]bool{
{{- range $.ServerPaths}}
	{{printf "%q" .}}: true,
{{- end}}
}

// requestValue returns v with a null value for each attribute that the server
// sets. When the resource changes, Terraform plans these attributes as
// unknown. A request does not send them, so a change check and an
// unknown-value check must not see them.
func requestValue(ctx context.Context, at string, v attr.Value, diags *diag.Diagnostics) attr.Value {
	if v == nil || v.IsNull() || v.IsUnknown() {
		return v
	}
	switch v := v.(type) {
	case types.Object:
		attrTypes := v.AttributeTypes(ctx)
		out := make(map[string]attr.Value, len(attrTypes))
		for name, child := range v.Attributes() {
			if serverAttrs[at+"."+name] {
				out[name] = nullValue(ctx, attrTypes[name], diags)
			} else {
				out[name] = requestValue(ctx, at+"."+name, child, diags)
			}
		}
		value, d := types.ObjectValue(attrTypes, out)
		diags.Append(d...)
		return value
	case types.List:
		elems := v.Elements()
		out := make([]attr.Value, len(elems))
		for i, child := range elems {
			out[i] = requestValue(ctx, at, child, diags)
		}
		value, d := types.ListValue(v.ElementType(ctx), out)
		diags.Append(d...)
		return value
	case types.Map:
		elems := v.Elements()
		out := make(map[string]attr.Value, len(elems))
		for key, child := range elems {
			out[key] = requestValue(ctx, at, child, diags)
		}
		value, d := types.MapValue(v.ElementType(ctx), out)
		diags.Append(d...)
		return value
	}
	return v
}

// nullValue returns the null value of type t.
func nullValue(ctx context.Context, t attr.Type, diags *diag.Diagnostics) attr.Value {
	value, err := t.ValueFromTerraform(ctx, tftypes.NewValue(t.TerraformType(ctx), nil))
	if err != nil {
		diags.AddError("Invalid value", err.Error())
	}
	return value
}
{{- end}}

{{if not .Existing}}func unknownValuePaths(p path.Path, value attr.Value) []path.Path {
	if value == nil || value.IsNull() {
		return nil
	}
	if value.IsUnknown() {
		return []path.Path{p}
	}
	var out []path.Path
	switch value := value.(type) {
	case types.Object:
		children := value.Attributes()
		for _, name := range sortedValueKeys(children) {
			out = append(out, unknownValuePaths(p.AtName(name), children[name])...)
		}
	case types.List:
		for index, child := range value.Elements() {
			out = append(out, unknownValuePaths(p.AtListIndex(index), child)...)
		}
	case types.Map:
		children := value.Elements()
		for _, key := range sortedValueKeys(children) {
			out = append(out, unknownValuePaths(p.AtMapKey(key), children[key])...)
		}
	case types.Set:
		for _, child := range value.Elements() {
			if len(unknownValuePaths(p, child)) != 0 {
				return []path.Path{p}
			}
		}
	}
	return out
}

func sortedValueKeys(values map[string]attr.Value) []string {
	keys := make([]string, 0, len(values))
	for key := range values {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

