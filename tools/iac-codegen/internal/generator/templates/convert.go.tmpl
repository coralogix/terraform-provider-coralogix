{{- if .Conv.PriorLists}}

// priorItems returns the items of the prior list, or nil when it cannot be read. The prior only
// keeps an order or the text of a document, so a prior that cannot be read is not an error.
func priorItems[T any](ctx context.Context, v elements) []T {
	var scratch diag.Diagnostics
	items := expandElements[T](ctx, path.Empty(), v, &scratch)
	if scratch.HasError() {
		return nil
	}
	return items
}
{{- end}}
{{- if .Conv.UsesPrior}}

// keepOrder returns the items in the order of the prior list, when the API returned the same items in
// another order. It expands the prior list to SDK values and compares them with same. The prior only
// keeps an order, so a prior that cannot be read is not an error.
func keepOrder[M, S any](ctx context.Context, items []S, prior types.List, expand func(context.Context, path.Path, *M, *diag.Diagnostics) *S, same func(a, b *S) bool) []S {
	var scratch diag.Diagnostics
	models := priorItems[M](ctx, prior)
	var priorSDK []S // nil for a prior list that is null: an empty API list then reads as null, as before
	if models != nil {
		priorSDK = make([]S, 0, len(models))
	}
	for i := range models {
		priorSDK = append(priorSDK, *expand(ctx, path.Empty(), &models[i], &scratch))
	}
	if scratch.HasError() {
		return items
	}
	return orderLike(items, priorSDK, same)
}

// orderLike returns prior when it holds the same items as items, in another order. Otherwise
// the items really changed, and the API order stays, so the plan shows the change.
func orderLike[T any](items, prior []T, same func(a, b *T) bool) []T {
	if items == nil || len(items) != len(prior) {
		return items // a missing list stays missing
	}
	used := make([]bool, len(prior))
	for i := range items {
		found := false
		for j := range prior {
			if !used[j] && same(&items[i], &prior[j]) {
				used[j], found = true, true
				break
			}
		}
		if !found {
			return items
		}
	}
	return prior
}
{{- if .Conv.UsesPriorVia}}

// keepOrderVia is keepOrder for a list whose response items the request does not send. It
// converts each API item to the model and both it and each prior item to the request value R,
// so the fields that only the server sets, such as an id or a hash, do not decide whether two
// items are the same. The API items keep those fields.
func keepOrderVia[M, S, R any](ctx context.Context, items []S, prior types.List, flatten func(context.Context, *S, *diag.Diagnostics) *M, expand func(context.Context, path.Path, *M, *diag.Diagnostics) *R, same func(a, b *R) bool) []S {
	var scratch diag.Diagnostics
	models := priorItems[M](ctx, prior)
	if items == nil || len(items) != len(models) {
		return items // a missing list stays missing
	}
	api := make([]R, 0, len(items))
	for i := range items {
		api = append(api, *expand(ctx, path.Empty(), flatten(ctx, &items[i], &scratch), &scratch))
	}
	priorValues := make([]R, 0, len(models))
	for i := range models {
		priorValues = append(priorValues, *expand(ctx, path.Empty(), &models[i], &scratch))
	}
	if scratch.HasError() {
		return items
	}
	if order, ok := priorOrder(api, priorValues, same); ok {
		return reordered(items, order)
	}
	return items
}

// priorOrder returns, for each prior item in order, the index of the item that matches it. ok is
// false when an item matches no prior item or the lists differ in length: the items really
// changed.
func priorOrder[T any](items, prior []T, same func(a, b *T) bool) (order []int, ok bool) {
	if items == nil || len(items) != len(prior) {
		return nil, false // a missing list stays missing
	}
	used := make([]bool, len(items))
	order = make([]int, 0, len(prior))
	for j := range prior {
		found := false
		for i := range items {
			if !used[i] && same(&items[i], &prior[j]) {
				used[i], found = true, true
				order = append(order, i)
				break
			}
		}
		if !found {
			return nil, false
		}
	}
	return order, true
}

// reordered returns items in the order of the indexes in order.
func reordered[T any](items []T, order []int) []T {
	out := make([]T, 0, len(order))
	for _, i := range order {
		out = append(out, items[i])
	}
	return out
}
{{- end}}

// pointerValue returns the value of p, or the zero value for nil. A missing value equals an empty one.
func pointerValue[T any](p *T) T {
	var zero T
	if p == nil {
		return zero
	}
	return *p
}

func sameObject[T any](a, b *T, same func(a, b *T) bool) bool {
	if a == nil || b == nil {
		return a == b
	}
	return same(a, b)
}

func sameList[T any](a, b []T, same func(a, b *T) bool) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if !same(&a[i], &b[i]) {
			return false
		}
	}
	return true
}

// sameUnordered reports whether a and b hold the same items, ignoring order. A nested list that
// keepPriorOrder restores can come back from the API shuffled; matching the parent object must
// still succeed so flatten can attach the prior nested list.
func sameUnordered[T any](a, b []T, same func(a, b *T) bool) bool {
	if len(a) != len(b) {
		return false
	}
	used := make([]bool, len(b))
	for i := range a {
		found := false
		for j := range b {
			if !used[j] && same(&a[i], &b[j]) {
				used[j], found = true, true
				break
			}
		}
		if !found {
			return false
		}
	}
	return true
}
{{- end}}

func flattenTime(v *time.Time) types.String {
	if v == nil {
		return types.StringNull()
	}
	return types.StringValue(v.Format(time.RFC3339Nano))
}

func flattenStringsSet[T ~string](ctx context.Context, v []T, diags *diag.Diagnostics) types.Set {
	if v == nil {
		return types.SetNull(types.StringType)
	}
	return flattenSet(ctx, types.StringType, toStrings(v), diags)
}

func flattenStringsList[T ~string](ctx context.Context, v []T, diags *diag.Diagnostics) types.List {
	if v == nil {
		return types.ListNull(types.StringType)
	}
	return flattenList(ctx, types.StringType, toStrings(v), diags)
}

func invalidEnumElement(p path.Path, value, zero string, diags *diag.Diagnostics) {
	if value == zero {
		diags.AddAttributeError(p, "Invalid API enum value", fmt.Sprintf("The API returned protobuf zero enum value %q in a collection. The API must omit this element or return a concrete enum value.", value))
	}
}

func flattenEnumsSet[T ~string](ctx context.Context, p path.Path, v []T, zero string, diags *diag.Diagnostics) types.Set {
	if v == nil {
		return types.SetNull(types.StringType)
	}
	items := toStrings(v)
	sort.Strings(items)
	for _, value := range items {
		invalidEnumElement(p, value, zero, diags)
	}
	return flattenSet(ctx, types.StringType, items, diags)
}

func flattenEnumsList[T ~string](ctx context.Context, p path.Path, v []T, zero string, diags *diag.Diagnostics) types.List {
	if v == nil {
		return types.ListNull(types.StringType)
	}
	items := toStrings(v)
	for index, value := range items {
		invalidEnumElement(p.AtListIndex(index), value, zero, diags)
	}
	return flattenList(ctx, types.StringType, items, diags)
}

func toStrings[T ~string](v []T) []string {
	out := make([]string, 0, len(v))
	for _, s := range v {
		out = append(out, string(s))
	}
	return out
}

func flattenSet[T any](ctx context.Context, elem attr.Type, items []T, diags *diag.Diagnostics) types.Set {
	s, d := types.SetValueFrom(ctx, elem, items)
	diags.Append(d...)
	return s
}

func flattenList[T any](ctx context.Context, elem attr.Type, items []T, diags *diag.Diagnostics) types.List {
	l, d := types.ListValueFrom(ctx, elem, items)
	diags.Append(d...)
	return l
}

{{- if or (.Conv.Uses "stringmap") (.Conv.Uses "uint64map") (.Conv.Uses "objectmap") (.Conv.Uses "scalarmap")}}

// expandMap returns the values of v. It returns nil for a null value, and a
// non-nil map for an empty value.
func expandMap[T any](ctx context.Context, p path.Path, v types.Map, diags *diag.Diagnostics) map[string]T {
	if v.IsNull() || v.IsUnknown() {
		return nil
	}
	out := map[string]T{}
	for _, d := range v.ElementsAs(ctx, &out, false) {
		diags.Append(diag.WithPath(p, d))
	}
	if out == nil {
		out = map[string]T{}
	}
	return out
}

func flattenMap[T any](ctx context.Context, elem attr.Type, items map[string]T, diags *diag.Diagnostics) types.Map {
	m, d := types.MapValueFrom(ctx, elem, items)
	diags.Append(d...)
	return m
}
{{- end}}
{{- if .Conv.Uses "stringmap"}}

func expandStringMap[T ~string](ctx context.Context, p path.Path, v types.Map, diags *diag.Diagnostics) map[string]T {
	items := expandMap[string](ctx, p, v, diags)
	if items == nil {
		return nil
	}
	out := make(map[string]T, len(items))
	for k, s := range items {
		out[k] = T(s)
	}
	return out
}

func flattenStringMap[T ~string](ctx context.Context, v map[string]T, diags *diag.Diagnostics) types.Map {
	if v == nil {
		return types.MapNull(types.StringType)
	}
	items := make(map[string]string, len(v))
	for k, s := range v {
		items[k] = string(s)
	}
	return flattenMap(ctx, types.StringType, items, diags)
}

func flattenEnumMap[T ~string](ctx context.Context, p path.Path, v map[string]T, zero string, diags *diag.Diagnostics) types.Map {
	if v == nil {
		return types.MapNull(types.StringType)
	}
	items := make(map[string]string, len(v))
	keys := make([]string, 0, len(v))
	for key, value := range v {
		items[key] = string(value)
		keys = append(keys, key)
	}
	sort.Strings(keys)
	for _, key := range keys {
		invalidEnumElement(p.AtMapKey(key), items[key], zero, diags)
	}
	return flattenMap(ctx, types.StringType, items, diags)
}
{{- end}}
{{- if .Conv.Uses "uint64map"}}

// expandUint64Map returns the decimal strings of the values of v.
func expandUint64Map(ctx context.Context, p path.Path, v types.Map, diags *diag.Diagnostics) map[string]string {
	items := expandMap[types.Int64](ctx, p, v, diags)
	if items == nil {
		return nil
	}
	out := make(map[string]string, len(items))
	for k, n := range items {
		if s := expandUint64(p.AtMapKey(k), n, diags); s != nil {
			out[k] = *s
		}
	}
	return out
}

func flattenUint64Map(ctx context.Context, p path.Path, v map[string]string, diags *diag.Diagnostics) types.Map {
	if v == nil {
		return types.MapNull(types.Int64Type)
	}
	items := make(map[string]types.Int64, len(v))
	for k, s := range v {
		items[k] = flattenUint64(p.AtMapKey(k), &s, diags)
	}
	return flattenMap(ctx, types.Int64Type, items, diags)
}
{{- end}}

