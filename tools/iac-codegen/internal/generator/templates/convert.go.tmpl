{{- define "carryExpand"}}
{{- $obj := .}}
{{- $carry := .Carry}}
// expand{{.Func}} sends the arm that the model sets, with the fields of {{.SDK}} that the arm
// holds in Terraform.
func expand{{.Func}}(ctx context.Context, p path.Path, m *{{.Model}}, diags *diag.Diagnostics) *{{$carry.Pkg}}.{{.SDK}} {
	if m == nil {
		return nil
	}
	out := &{{$carry.Pkg}}.{{.SDK}}{}
{{- range .Carry.Arms}}
{{- $arm := .}}
	if arm := m.{{.Model}}; arm != nil {
		p := p.AtName({{printf "%q" .TFName}})
		m := arm
{{- range .Siblings}}
{{- template "expandField" .}}
{{- end}}
		oneOf := &{{$carry.Pkg}}.{{$carry.Field.Object.SDK}}{}
{{- range .Folds}}
		if flag := m.{{.Flag}}; !flag.IsNull() && !flag.IsUnknown() && !flag.ValueBool() {
			// false selects the arm that Terraform shows in this one.
			kept := expand{{$arm.Object.Func}}(ctx, p, m, diags)
			oneOf.{{.SDK}} = &{{.SDKType}}{ {{- range $i, $f := .Fields}}{{if $i}}, {{end}}{{$f}}: kept.{{$f}}{{end -}} }
		} else {
			oneOf.{{$arm.SDK}} = expand{{$arm.Object.Func}}(ctx, p, m, diags)
		}
{{- else}}
		oneOf.{{.SDK}} = expand{{.Object.Func}}(ctx, p, m, diags)
{{- end}}
		out.{{$carry.Field.SDK}} = {{if $carry.Field.Value}}*{{end}}oneOf
	}
{{- end}}
	return out
}
{{- end}}

{{- define "carryFlatten"}}
{{- $obj := .}}
{{- $carry := .Carry}}
// flatten{{.Func}} reads the arm of {{.SDK}} with the fields of {{.SDK}} that the arm holds in
// Terraform.
func flatten{{.Func}}(ctx context.Context, p path.Path, v *{{$carry.Pkg}}.{{.SDK}}, {{if .NeedsPrior}}prior *{{.Model}}, {{end}}diags *diag.Diagnostics) *{{.Model}} {
	if v == nil {
		return nil
	}
	out := &{{.Model}}{}
	oneOf := {{if $carry.Field.Value}}&{{end}}v.{{$carry.Field.SDK}}
{{- if $carry.RequireOne}}
	arms := 0
	if oneOf != nil {
{{- range $carry.Field.Object.Fields}}
		if oneOf.{{.SDK}} != nil {
			arms++
		}
{{- end}}
	}
	if arms != 1 {
		diags.AddAttributeError(p, "Invalid response from server", fmt.Sprintf("The response has %d of {{range $i, $f := $carry.Field.Object.Fields}}{{if $i}}, {{end}}{{$f.TFName}}{{end}}; it must have exactly one.", arms))
	}
{{- end}}
	if oneOf == nil {
		return out
	}
{{- range .Carry.Arms}}
{{- $arm := .}}
	{
{{- if $obj.NeedsPrior}}
		var priorArm *{{.Object.Model}}
		if prior != nil {
			priorArm = prior.{{.Model}}
		}
{{- end}}
		var arm *{{.Object.Model}}
{{- range .Folds}}
{{- $fold := .}}
		if oneOf.{{.SDK}} != nil {
			kept := &{{$carry.Pkg}}.{{$arm.Object.SDK}}{ {{- range $i, $f := .Fields}}{{if $i}}, {{end}}{{$f}}: oneOf.{{$fold.SDK}}.{{$f}}{{end -}} }
			arm = flatten{{$arm.Object.Func}}(ctx, p.AtName({{printf "%q" $arm.TFName}}), kept, {{if $arm.Object.NeedsPrior}}priorArm, {{end}}diags)
			arm.{{.Flag}} = types.BoolValue(false)
		}
{{- end}}
		if oneOf.{{.SDK}} != nil {
			arm = flatten{{.Object.Func}}(ctx, p.AtName({{printf "%q" .TFName}}), oneOf.{{.SDK}}, {{if .Object.NeedsPrior}}priorArm, {{end}}diags)
{{- range .Folds}}
			arm.{{.Flag}} = types.BoolValue(true)
{{- end}}
		}
		if arm != nil {
			out := arm
{{- if $obj.NeedsPrior}}
			prior := priorArm
			_ = prior
{{- end}}
{{- range .Siblings}}
{{- template "flattenField" .}}
{{- end}}
		}
		out.{{.Model}} = arm
	}
{{- end}}
	return out
}
{{- end}}

{{- define "typedExpand"}}
{{- $typed := .Typed}}
{{- $type := .Typed.TypeField}}
{{- if .Group}}
// expand{{.Func}} sets the arm that the type attribute names in out, the API object that holds the
// arms of the group.
func expand{{.Func}}(ctx context.Context, p path.Path, m *{{.Model}}, out *{{$typed.Pkg}}.{{.SDK}}, diags *diag.Diagnostics) {
	if m == nil {
		return
	}
{{- else}}
// expand{{.Func}} sends the arm that the type attribute names, with the merged fields that the arm
// holds in the API.
func expand{{.Func}}(ctx context.Context, p path.Path, m *{{.Model}}, diags *diag.Diagnostics) *{{$typed.Pkg}}.{{.SDK}} {
	if m == nil {
		return nil
	}
	out := &{{$typed.Pkg}}.{{.SDK}}{}
{{- end}}
{{- range .Parents}}
	out.{{.SDK}} = &{{.Type}}{} // an inlined object: its arms are the arms of this object
{{- end}}
	kind := m.{{$type.Model}}.ValueString()
{{- if $typed.Infer}}
	if m.{{$type.Model}}.IsNull() || m.{{$type.Model}}.IsUnknown() {
		// The configuration leaves the type out, so it comes from the fields that are set.
		var unknown bool
		kind, unknown = inferTypedKind({{$typed.InferArms}}, map[string]attr.Value{
{{- range $typed.InferFields}}
			{{printf "%q" .TFName}}: m.{{.Model}},
{{- end}}
		})
		if unknown {
			diags.AddAttributeError(p.AtName({{printf "%q" $type.TFName}}), "Cannot choose the {{$type.TFName}}", "A field that decides the {{$type.TFName}} is unknown.")
			return nil
		}
	}
{{- end}}
	switch kind {
{{- range $typed.Arms}}
	case {{printf "%q" .Value}}:
{{- if .Inline}}
		out.{{.SDK}} = expand{{.Object.Func}}(ctx, p, &{{.Object.Model}}{
			{{.Inline.Model}}: &{{.Inner.Model}}{
{{- range .Pairs}}
				{{.Arm}}: m.{{.Merged}},
{{- end}}
			},
		}, diags)
{{- else if .Object}}
		out.{{.SDK}} = expand{{.Object.Func}}(ctx, p, &{{.Object.Model}}{
{{- range .Pairs}}
			{{.Arm}}: m.{{.Merged}},
{{- end}}
		}, diags)
{{- else if .Empty}}
		out.{{.SDK}} = map[string]interface{}{}
{{- else}}
{{- template "expandField" .Scalar}}
{{- end}}
{{- end}}
	default:
		diags.AddAttributeError(p.AtName({{printf "%q" $type.TFName}}), "Unknown {{$type.TFName}}", fmt.Sprintf({{printf "%q" (print "The " $type.TFName " %q is not one of " $typed.Allowed ".")}}, m.{{$type.Model}}.ValueString()))
	}
{{- if not .Group}}
	return out
{{- end}}
}
{{- end}}

{{- define "typedFlatten"}}
{{- $typed := .Typed}}
{{- $type := .Typed.TypeField}}
// flatten{{.Func}} reads the arm of {{.SDK}} as the type attribute and the merged fields.
func flatten{{.Func}}(ctx context.Context, p path.Path, v *{{$typed.Pkg}}.{{.SDK}}, {{if .NeedsPrior}}prior *{{.Model}}, {{end}}diags *diag.Diagnostics) *{{.Model}} {
	if v == nil {
		return nil
	}
{{- if .OptionalGroup}}
	if {{range $i, $f := .LeafSDK}}{{if $i}} && {{end}}v.{{$f}} == nil{{end}} {
		return nil // the response has none of the arms: the group is null
	}
{{- end}}
{{- if .FlattenParents}}
	// A response without the inlined object has no arm, which the switch below reports.
	copied := *v
	v = &copied
{{- range .FlattenParents}}
	if v.{{.SDK}} == nil {
		v.{{.SDK}} = &{{.Type}}{}
	}
{{- end}}
{{- end}}
	out := &{{.Model}}{}
{{- $obj := .}}
{{- range $typed.Arms}}
{{- range .Inits}}
	// A field that the selected arm does not have reads as an absent value.
	if empty := flatten{{.Object.Func}}(ctx, p, &{{$typed.Pkg}}.{{.Object.SDK}}{}, {{if .Object.NeedsPrior}}nil, {{end}}diags); empty != nil {
{{- range .Fields}}
		out.{{.Merged}} = empty.{{.Arm}}
{{- end}}
	}
{{- end}}
{{- if .InitScalar}}
	{
		v := &{{$typed.Pkg}}.{{$obj.SDK}}{}
{{- range $obj.FlattenParents}}
		v.{{.SDK}} = &{{.Type}}{}
{{- end}}
{{- template "flattenField" .Scalar}}
	}
{{- end}}
{{- end}}
	switch {
{{- range $typed.Arms}}
	case v.{{.SDK}} != nil:
		out.{{$type.Model}} = types.StringValue({{printf "%q" .Value}})
{{- if .Inline}}
{{- $arm := .}}
{{- if and $obj.NeedsPrior .Object.NeedsPrior}}
		// The prior of the arm is the prior object, when it had this type.
		var priorArm *{{.Object.Model}}
		if prior != nil && prior.{{$type.Model}}.ValueString() == {{printf "%q" .Value}} {
			priorArm = &{{.Object.Model}}{
				{{.Inline.Model}}: &{{.Inner.Model}}{
{{- range .Pairs}}
					{{.Arm}}: prior.{{.Merged}},
{{- end}}
				},
			}
		}
{{- end}}
		if arm := flatten{{.Object.Func}}(ctx, p, v.{{.SDK}}, {{if .Object.NeedsPrior}}{{if $obj.NeedsPrior}}priorArm{{else}}nil{{end}}, {{end}}diags); arm != nil && arm.{{.Inline.Model}} != nil {
{{- range .Pairs}}
			out.{{.Merged}} = arm.{{$arm.Inline.Model}}.{{.Arm}}
{{- end}}
		}
{{- else if .Object}}
{{- if and $obj.NeedsPrior .Object.NeedsPrior}}
		// The prior of the arm is the prior object, when it had this type.
		var priorArm *{{.Object.Model}}
		if prior != nil && prior.{{$type.Model}}.ValueString() == {{printf "%q" .Value}} {
			priorArm = &{{.Object.Model}}{
{{- range .Pairs}}
				{{.Arm}}: prior.{{.Merged}},
{{- end}}
			}
		}
{{- end}}
		if arm := flatten{{.Object.Func}}(ctx, p, v.{{.SDK}}, {{if .Object.NeedsPrior}}{{if $obj.NeedsPrior}}priorArm{{else}}nil{{end}}, {{end}}diags); arm != nil {
{{- range .Pairs}}
			out.{{.Merged}} = arm.{{.Arm}}
{{- end}}
		}
{{- else if .Scalar}}
{{- template "flattenField" .Scalar}}
{{- end}}
{{- end}}
	default:
		diags.AddAttributeError(p, "Invalid response from server", "The response has none of{{range $typed.Arms}} {{.SDK}}{{end}}; it must have one.")
	}
{{- range .Fields}}{{if .EmptyDefault}}
	if out.{{.Model}}.IsNull() {
		// An arm that lacks the field, or an answer without values, reads as the default. An import
		// has no prior value to restore the empty collection from.
		out.{{.Model}} = {{.EmptyDefault}}
	}
{{- end}}{{end}}
	return out
}
{{- end}}
