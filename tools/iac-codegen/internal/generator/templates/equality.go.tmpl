// yamlEqual reports whether a and b are the same YAML document. A string that is not YAML only
// equals itself. Numbers compare by their exact value, so two numbers that one float64 holds stay
// different.
func yamlEqual(a, b string) bool {
	if a == b {
		return true
	}
	var left, right yaml.Node
	if yaml.Unmarshal([]byte(a), &left) != nil || yaml.Unmarshal([]byte(b), &right) != nil {
		return false
	}
	l, lok := yamlValue(&left)
	r, rok := yamlValue(&right)
	return lok && rok && reflect.DeepEqual(l, r)
}

// yamlValue decodes n like yaml.Unmarshal, with each number as an exactNumber that keeps its tag.
// It is false for a document that it cannot compare: a merge key, a key that is a collection, or a
// key that the document repeats.
func yamlValue(n *yaml.Node) (any, bool) {
	switch n.Kind {
	case 0:
		return nil, true
	case yaml.DocumentNode:
		if len(n.Content) == 0 {
			return nil, true
		}
		return yamlValue(n.Content[0])
	case yaml.AliasNode:
		return yamlValue(n.Alias)
	case yaml.SequenceNode:
		out := make([]any, 0, len(n.Content))
		for _, item := range n.Content {
			v, ok := yamlValue(item)
			if !ok {
				return nil, false
			}
			out = append(out, v)
		}
		return out, true
	case yaml.MappingNode:
		return yamlMapping(n)
	}
	var v any
	if n.Decode(&v) != nil {
		return nil, false
	}
	if number, ok := yamlNumber(n, v); ok {
		return number, true
	}
	return v, true
}

// yamlNumber returns the exact value of a number scalar n, which yaml decoded as v. It keeps the tag,
// so an integer and a float stay different, as yaml.Unmarshal decodes them.
func yamlNumber(n *yaml.Node, v any) (exactNumber, bool) {
	switch tag := n.ShortTag(); tag {
	case "!!int":
		switch v := v.(type) {
		case int:
			return exactNumber(tag + ":" + strconv.Itoa(v)), true
		case int64:
			return exactNumber(tag + ":" + strconv.FormatInt(v, 10)), true
		case uint64:
			return exactNumber(tag + ":" + strconv.FormatUint(v, 10)), true
		}
		// An integer beyond 64 bits, which yaml decodes as a float64.
		if i, ok := new(big.Int).SetString(n.Value, 0); ok {
			return exactNumber(tag + ":" + i.String()), true
		}
	case "!!float":
		if r, ok := new(big.Rat).SetString(n.Value); ok {
			return exactNumber(tag + ":" + r.RatString()), true
		}
	}
	return "", false
}

func yamlMapping(n *yaml.Node) (any, bool) {
	out := make(map[any]any, len(n.Content)/2)
	for i := 0; i+1 < len(n.Content); i += 2 {
		if n.Content[i].ShortTag() == "!!merge" {
			return nil, false
		}
		key, ok := yamlValue(n.Content[i])
		if !ok || key != nil && !reflect.TypeOf(key).Comparable() {
			return nil, false
		}
		if _, seen := out[key]; seen {
			return nil, false
		}
		if out[key], ok = yamlValue(n.Content[i+1]); !ok {
			return nil, false
		}
	}
	return out, true
}
