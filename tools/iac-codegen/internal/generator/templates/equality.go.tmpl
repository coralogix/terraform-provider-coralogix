// yamlEqual reports whether a and b are the same YAML document. A string that is not YAML only
// equals itself.
func yamlEqual(a, b string) bool {
	if a == b {
		return true
	}
	var left, right any
	if yaml.Unmarshal([]byte(a), &left) != nil || yaml.Unmarshal([]byte(b), &right) != nil {
		return false
	}
	return reflect.DeepEqual(left, right)
}
{{- end}}
{{- if .Conv.UsesEquality "json"}}

// jsonEqual reports whether a and b are the same JSON value. A string that is not JSON only
// equals itself.
func jsonEqual(a, b string) bool {
	if a == b {
		return true
	}
	var left, right any
	if json.Unmarshal([]byte(a), &left) != nil || json.Unmarshal([]byte(b), &right) != nil {
		return false
	}
	return reflect.DeepEqual(left, right)
}
{{- end}}

// equivalentDocument plans the state value when the configured document is the same document in
// another format, so a change of format alone plans no change.
type equivalentDocument struct{ equal func(a, b string) bool }

func (m equivalentDocument) Description(context.Context) string {
	return "Keeps the state value when the configured document is equal to it."
}

func (m equivalentDocument) MarkdownDescription(ctx context.Context) string {
	return m.Description(ctx)
}

func (m equivalentDocument) PlanModifyString(_ context.Context, req planmodifier.StringRequest, resp *planmodifier.StringResponse) {
	if req.ConfigValue.IsNull() || req.ConfigValue.IsUnknown() || req.StateValue.IsNull() || req.StateValue.IsUnknown() {
		return
	}
	if m.equal(req.ConfigValue.ValueString(), req.StateValue.ValueString()) {
		resp.PlanValue = req.StateValue
	}
}

// keepEquivalentText returns prior when the API returns the same document in another format, so
// the state keeps the text of the configuration. Without a prior value, after an import for
// example, it returns the value of the API.
func keepEquivalentText(prior, api types.String, equal func(a, b string) bool) types.String {
	if prior.IsNull() || prior.IsUnknown() || api.IsNull() || api.IsUnknown() {
		return api
	}
	if equal(prior.ValueString(), api.ValueString()) {
		return prior
	}
	return api
}

// ModifyPlan plans no change when the configuration differs from the state only in the format of
// a document. Terraform marks every computed attribute that the configuration does not set unknown
// when the configuration changes, before equivalentDocument keeps the state of the documents. When
// every known planned value is the state, those unknown values are the only difference, and nothing
// changes.
func (r *Resource) ModifyPlan(_ context.Context, req resource.ModifyPlanRequest, resp *resource.ModifyPlanResponse) {
	if req.State.Raw.IsNull() || req.Plan.Raw.IsNull() {
		return // Create and Delete.
	}
	if onlyUnsetUnknowns(req.Plan.Raw, req.Config.Raw, req.State.Raw) {
		resp.Plan.Raw = req.State.Raw
	}
}

// onlyUnsetUnknowns reports whether plan is state, except for unknown values where config has no
// value. An unknown value that the configuration sets, from a variable for example, stays a change.
func onlyUnsetUnknowns(plan, config, state tftypes.Value) bool {
	filled, err := tftypes.Transform(plan, func(p *tftypes.AttributePath, v tftypes.Value) (tftypes.Value, error) {
		if v.IsKnown() {
			return v, nil
		}
		if configured, ok := valueAt(config, p); !ok || !configured.IsNull() {
			return v, nil
		}
		if prior, ok := valueAt(state, p); ok {
			return prior, nil
		}
		return v, nil
	})
	return err == nil && filled.Equal(state)
}

// valueAt returns the value at the path p of v.
func valueAt(v tftypes.Value, p *tftypes.AttributePath) (tftypes.Value, bool) {
	found, _, err := tftypes.WalkAttributePath(v, p)
	if err != nil {
		return tftypes.Value{}, false
	}
	value, ok := found.(tftypes.Value)
	return value, ok
}
