+// The handwritten glue of the generated analytics alert types (D20): it sets
+// the properties that every alert type has, and calls the generated expand
+// and flatten.
+
+package alerts
+
+import (
+	"context"
+
+	alerts "github.com/coralogix/coralogix-management-sdk/go/openapi/gen/alert_definitions_service"
+	"github.com/hashicorp/terraform-plugin-framework/diag"
+	"github.com/hashicorp/terraform-plugin-framework/path"
+	"github.com/hashicorp/terraform-plugin-framework/types"
+	"github.com/hashicorp/terraform-plugin-framework/types/basetypes"
+
+	alerttypes "github.com/coralogix/terraform-provider-coralogix/internal/provider/alerts/alert_types"
+	"github.com/coralogix/terraform-provider-coralogix/internal/provider/alerts/generated"
+	"github.com/coralogix/terraform-provider-coralogix/internal/utils"
+)
+
+func expandAnalyticsAlertsTypeDefinition(ctx context.Context, properties *alerts.AlertDefProperties, def alerttypes.AlertTypeDefinitionModel, model alerttypes.AlertResourceModel) (*alerts.AlertDefProperties, bool, diag.Diagnostics) {
+	p := path.Root("type_definition")
+	switch {
+	case !utils.ObjIsNullOrUnknown(def.AnalyticsThreshold):
+		var m generated.AnalyticsThresholdTypeModel
+		if diags := def.AnalyticsThreshold.As(ctx, &m, basetypes.ObjectAsOptions{}); diags.HasError() {
+			return nil, true, diags
+		}
+		v, diags := generated.ExpandAnalyticsThresholdType(ctx, p.AtName("analytics_threshold"), &m)
+		diags.Append(expandCommonAlertProperties(ctx, properties, model)...)
+		properties.AnalyticsThreshold = v
+		properties.Type = alerts.ALERTDEFTYPE_ALERT_DEF_TYPE_ANALYTICS_THRESHOLD.Ptr()
+		return properties, true, diags
+	case !utils.ObjIsNullOrUnknown(def.AnalyticsImmediate):
+		var m generated.AnalyticsImmediateTypeModel
+		if diags := def.AnalyticsImmediate.As(ctx, &m, basetypes.ObjectAsOptions{}); diags.HasError() {
+			return nil, true, diags
+		}
+		v, diags := generated.ExpandAnalyticsImmediateType(ctx, p.AtName("analytics_immediate"), &m)
+		diags.Append(expandCommonAlertProperties(ctx, properties, model)...)
+		properties.AnalyticsImmediate = v
+		properties.Type = alerts.ALERTDEFTYPE_ALERT_DEF_TYPE_ANALYTICS_IMMEDIATE.Ptr()
+		return properties, true, diags
+	}
+	return properties, false, nil
+}
+
+func flattenAnalyticsAlertTypeDefinition(ctx context.Context, properties *alerts.AlertDefProperties, model *alerttypes.AlertTypeDefinitionModel) (diag.Diagnostics, bool) {
+	p := path.Root("type_definition")
+	switch {
+	case properties.AnalyticsThreshold != nil:
+		m, diags := generated.FlattenAnalyticsThresholdType(ctx, p.AtName("analytics_threshold"), properties.AnalyticsThreshold)
+		if diags.HasError() {
+			return diags, true
+		}
+		obj, d := types.ObjectValueFrom(ctx, generated.AnalyticsThresholdTypeAttrTypes(), m)
+		model.AnalyticsThreshold = obj
+		return append(diags, d...), true
+	case properties.AnalyticsImmediate != nil:
+		m, diags := generated.FlattenAnalyticsImmediateType(ctx, p.AtName("analytics_immediate"), properties.AnalyticsImmediate)
+		if diags.HasError() {
+			return diags, true
+		}
+		obj, d := types.ObjectValueFrom(ctx, generated.AnalyticsImmediateTypeAttrTypes(), m)
+		model.AnalyticsImmediate = obj
+		return append(diags, d...), true
+	}
+	return nil, false
+}
+
+// expandCommonAlertProperties sets the properties that every alert type has,
+// as each handwritten alert type does.
+func expandCommonAlertProperties(ctx context.Context, properties *alerts.AlertDefProperties, model alerttypes.AlertResourceModel) diag.Diagnostics {
+	groupBy, diags := utils.TypeStringElementsToStringSlice(ctx, model.GroupBy.Elements())
+	incidentsSettings, d := extractIncidentsSettings(ctx, model.IncidentsSettings)
+	diags.Append(d...)
+	notificationGroup, d := extractNotificationGroup(ctx, model.NotificationGroup)
+	diags.Append(d...)
+	labels, d := utils.TypeMapToStringMap(ctx, model.Labels)
+	diags.Append(d...)
+	schedule, d := expandActiveOnSchedule(ctx, model.Schedule)
+	diags.Append(d...)
+	properties.Name = model.Name.ValueStringPointer()
+	properties.Description = model.Description.ValueStringPointer()
+	properties.Enabled = model.Enabled.ValueBoolPointer()
+	properties.Priority = alerttypes.AlertPrioritySchemaToProtoMap[extractAlertPriority(model.Priority)].Ptr()
+	properties.GroupByKeys = groupBy
+	properties.IncidentsSettings = incidentsSettings
+	properties.NotificationGroup = notificationGroup
+	properties.EntityLabels = labels
+	properties.PhantomMode = model.PhantomMode.ValueBoolPointer()
+	properties.ActiveOn = schedule
+	return diags
+}
