+package alerts
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	alerts "github.com/coralogix/coralogix-management-sdk/go/openapi/gen/alert_definitions_service"
+	"github.com/hashicorp/terraform-plugin-framework/types/basetypes"
+
+	alertschema "github.com/coralogix/terraform-provider-coralogix/internal/provider/alerts/alert_schema"
+	alerttypes "github.com/coralogix/terraform-provider-coralogix/internal/provider/alerts/alert_types"
+)
+
+func ptrOf[T any](v T) *T { return &v }
+
+// TestAnalyticsRoundTrip runs the generated analytics types through the
+// handwritten alert code: flatten of the type definition, then expand, gives
+// the same API values and the right alert type.
+func TestAnalyticsRoundTrip(t *testing.T) {
+	ctx := context.Background()
+	threshold := &alerts.AnalyticsThresholdType{
+		DataprimeQuery:    &alerts.DataprimeAlertQuery{Query: ptrOf("source logs | count")},
+		EvaluationDelayMs: ptrOf(int32(0)),
+		NoDataPolicy:      &alerts.NoDataPolicy{AutoRetireSeconds: ptrOf(int32(600)), State: alerts.NODATAPOLICYSTATE_NO_DATA_POLICY_STATE_UNSPECIFIED.Ptr()},
+		Operator:          alerts.ANALYTICSTHRESHOLDOPERATOR_ANALYTICS_THRESHOLD_OPERATOR_MORE_THAN_OR_UNSPECIFIED.Ptr(),
+		Rules: []alerts.AnalyticsThresholdRule{
+			{Condition: &alerts.AnalyticsThresholdRuleCondition{Threshold: ptrOf(10.0)},
+				Override: &alerts.AlertDefOverride{Priority: alerts.ALERTDEFPRIORITY_ALERT_DEF_PRIORITY_P1.Ptr()}},
+			{Condition: &alerts.AnalyticsThresholdRuleCondition{Threshold: ptrOf(0.5)}},
+		},
+		TargetColumn:          ptrOf("count"),
+		TimeframeMinutes:      ptrOf(int32(5)),
+		UseRowsAsPermutations: ptrOf(false),
+	}
+	for _, c := range []struct {
+		name  string
+		props *alerts.AlertDefProperties
+		want  alerts.AlertDefType
+	}{
+		{"threshold", &alerts.AlertDefProperties{AnalyticsThreshold: threshold}, alerts.ALERTDEFTYPE_ALERT_DEF_TYPE_ANALYTICS_THRESHOLD},
+		{"immediate", &alerts.AlertDefProperties{AnalyticsImmediate: &alerts.AnalyticsImmediateType{
+			DataprimeQuery: &alerts.DataprimeAlertQuery{Query: ptrOf("source logs")}, TimeframeMinutes: ptrOf(int32(1))}},
+			alerts.ALERTDEFTYPE_ALERT_DEF_TYPE_ANALYTICS_IMMEDIATE},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			obj, diags := flattenAlertTypeDefinition(ctx, c.props)
+			if diags.HasError() {
+				t.Fatalf("flatten: %v", diags)
+			}
+			model := alerttypes.AlertResourceModel{TypeDefinition: obj}
+			got, diags := expandAlertsTypeDefinition(ctx, &alerts.AlertDefProperties{}, model)
+			if diags.HasError() {
+				t.Fatalf("expand: %v", diags)
+			}
+			if got.Type == nil || *got.Type != c.want {
+				t.Errorf("type = %v, want %s", got.Type, c.want)
+			}
+			for _, pair := range [][2]any{{got.AnalyticsThreshold, c.props.AnalyticsThreshold}, {got.AnalyticsImmediate, c.props.AnalyticsImmediate}} {
+				g, _ := json.Marshal(pair[0])
+				w, _ := json.Marshal(pair[1])
+				if string(g) != string(w) {
+					t.Errorf("got %s\nwant %s", g, w)
+				}
+			}
+		})
+	}
+}
+
+// TestAnalyticsInSchema checks that the resource schema with the generated
+// attributes is valid, and that its type matches the handwritten attribute
+// types map.
+func TestAnalyticsInSchema(t *testing.T) {
+	ctx := context.Background()
+	s := alertschema.V3()
+	if diags := s.ValidateImplementation(ctx); diags.HasError() {
+		t.Fatalf("schema: %v", diags)
+	}
+	td, ok := s.Attributes["type_definition"].GetType().(basetypes.ObjectType)
+	if !ok {
+		t.Fatal("type_definition is not an object")
+	}
+	for _, name := range []string{"analytics_threshold", "analytics_immediate"} {
+		want := alertschema.AlertTypeDefinitionAttr()[name]
+		if want == nil || !td.AttrTypes[name].Equal(want) {
+			t.Errorf("%s: schema type %s, handwritten attribute types %s", name, td.AttrTypes[name], want)
+		}
+	}
+}
