 "TestDynamicWidgetSpansAndDataPrimeQueryFullFidelityRoundTrip": {
  "queryDefinitions": [
   {
    "id": "query-1",
    "name": "spans",
    "query": {
     "spans": {
      "aggregation": [
       {
        "count": {}
       }
      ],
      "dataModeType": "DATA_MODE_TYPE_ARCHIVE",
      "filters": [
       {
        "field": {
         "metadataField": "METADATA_FIELD_APPLICATION_NAME"
        },
        "operator": {
         "equals": {
          "selection": {
           "list": {
            "values": [
             "api"
            ]
           }
          }
         }
        }
       },
       {
        "observationField": {
         "keypath": [
          "servicename"
         ],
         "relationType": "SPAN_RELATION_TYPE_NONE_UNSPECIFIED",
         "scope": "DATASET_SCOPE_LABEL"
        },
        "operator": {
         "notEquals": {
          "selection": {
           "list": {
            "values": [
             "codex-app-server"
            ]
           }
          }
         }
        }
       }
      ],
      "groupBy": [
       {
        "keypath": [
         "service",
         "name"
        ],
        "relationType": "SPAN_RELATION_TYPE_PARENT",
        "scope": "DATASET_SCOPE_USER_DATA"
       }
      ],
      "luceneQuery": {
       "value": "*"
      }
     }
    }
   },
   {
    "id": "query-2",
    "name": "data prime",
    "query": {
     "dataprime": {
      "dataModeType": "DATA_MODE_TYPE_ARCHIVE",
      "dataprimeQuery": {
       "text": "source logs | limit 10"
      }
     }
    }
   }
  ],
  "visualization": {
   "stat": {
    "thresholds": [],
    "unit": "UNIT_BYTES"
   }
  }
 },
