+// The parts of the handwritten dynamic widget that other widgets still use.
+// The dynamic widget itself runs on the generated types (dynamic_switched.go).
+
+package dashboard_widgets
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	dashboardservice "github.com/coralogix/coralogix-management-sdk/go/openapi/gen/dashboard_service"
