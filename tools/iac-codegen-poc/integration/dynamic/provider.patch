-	if diags.HasError() {
-		return nil, diags
-	}
-
-	rules, diags := expandDynamicTableRules(ctx, table.Rules)
-	if diags.HasError() {
-		return nil, diags
-	}
-
-	settings, diags := expandDynamicTableSettings(ctx, table.Settings)
-	if diags.HasError() {
-		return nil, diags
-	}
-
-	return &dashboardservice.Table{
-		Columns:  columns,
-		Rules:    rules,
-		Settings: settings,
-	}, nil
-}
