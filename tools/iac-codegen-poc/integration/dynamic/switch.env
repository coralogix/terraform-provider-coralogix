# Inputs of integration/switch.sh and integration/live.sh for the dynamic
# widget of coralogix_dashboard (a partial switch: the other widgets and the
# rest of the dashboard stay handwritten).
ROOT=widgets.Dynamic
TAG="Dashboard service"
PKG=internal/provider/dashboards/dashboard_widgets/dynamictypes   # the generated package
TEST_DIR=internal/provider/dashboards/dashboard_widgets            # the handwritten package, for the checks
LIVE_ADDRESS=coralogix_dashboard.example                           # the resource that live.sh imports
