	out := make([]T, 0, len(items))
	for _, s := range items {
		e, ok := byName[s]
		if !ok {
			diags.AddAttributeError(p, "Invalid value", fmt.Sprintf("%q is not a valid value.", s))
			continue
		}
		out = append(out, e)
	}
	return out
}

// enumNames returns the Terraform names of the API values v. A value with no
// name is an error.
func enumNames[T ~string](p path.Path, v []T, name func(T) (string, bool), diags *diag.Diagnostics) []string {
	out := make([]string, 0, len(v))
	for _, e := range v {
		n, ok := name(e)
		if !ok {
			diags.AddAttributeError(p, "Unknown API value", fmt.Sprintf("The API returned %q, which has no Terraform name. Regenerate the types.", e))
			continue
		}
		out = append(out, n)
	}
	return out
}

func flattenEnumNamesList[T ~string](ctx context.Context, p path.Path, v []T, name func(T) (string, bool), diags *diag.Diagnostics) types.List {
	if v == nil {
		return types.ListNull(types.StringType)
	}
	return flattenList(ctx, types.StringType, enumNames(p, v, name, diags), diags)
}

func flattenEnumNamesSet[T ~string](ctx context.Context, p path.Path, v []T, name func(T) (string, bool), diags *diag.Diagnostics) types.Set {
	if v == nil {
		return types.SetNull(types.StringType)
	}
	return flattenSet(ctx, types.StringType, enumNames(p, v, name, diags), diags)
}
{{- end}}
{{- if .Conv.Uses "int32wide"}}

// expandInt32Wide returns v as the int32 that the API has. The attribute is
// an Int64, like the handwritten resource (D21), so a value out of range is
// an error.
func expandInt32Wide(p path.Path, v types.Int64, diags *diag.Diagnostics) *int32 {
	if v.IsNull() || v.IsUnknown() {
		return nil
	}
	n := v.ValueInt64()
	if n < math.MinInt32 || n > math.MaxInt32 {
		diags.AddAttributeError(p, "Invalid value", fmt.Sprintf("The value %d is out of range: the API accepts a 32-bit number.", n))
		return nil
	}
	i := int32(n)
	return &i
}

func flattenInt32Wide(v *int32) types.Int64 {
	if v == nil {
		return types.Int64Null()
	}
	return types.Int64Value(int64(*v))
}
{{- end}}
{{- if .Conv.Uses "float32wide"}}

func expandFloat32Wide(v types.Float64) *float32 {
	if v.IsNull() || v.IsUnknown() {
		return nil
	}
	f := float32(v.ValueFloat64())
	return &f
}

// flattenFloat32Wide returns the shortest decimal of the float32 v as a
// Float64, so 0.1 reads back as 0.1, not 0.10000000149.
func flattenFloat32Wide(v *float32) types.Float64 {
	if v == nil {
		return types.Float64Null()
	}
	f, _ := strconv.ParseFloat(strconv.FormatFloat(float64(*v), 'g', -1, 32), 64)
	return types.Float64Value(f)
}
{{- end}}
{{- if .Conv.Uses "scalarmap"}}

func flattenScalarMap[T any](ctx context.Context, elem attr.Type, v map[string]T, diags *diag.Diagnostics) types.Map {
	if v == nil {
		return types.MapNull(elem)
	}
	return flattenMap(ctx, elem, v, diags)
}
