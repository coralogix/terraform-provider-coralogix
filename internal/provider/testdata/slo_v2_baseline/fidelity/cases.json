{
  "cases": [
    {
      "name": "request based: create, read, replace, delete",
      "steps": [
        {
          "method": "POST",
          "path": "",
          "capture": "id",
          "body": {
            "name": "tf-fidelity-request",
            "targetThresholdPercentage": 99.5,
            "sloTimeFrame": "SLO_TIME_FRAME_7_DAYS",
            "requestBasedMetricSli": {
              "goodEvents": {
                "query": "sum(rate(http_requests_total{status=\"200\"}[1m])) by (service)"
              },
              "totalEvents": {
                "query": "sum(rate(http_requests_total[1m])) by (service)"
              }
            }
          }
        },
        {
          "method": "GET",
          "path": "/{{id}}"
        },
        {
          "method": "PUT",
          "path": "",
          "body": {
            "name": "tf-fidelity-request-2",
            "targetThresholdPercentage": 99.9,
            "sloTimeFrame": "SLO_TIME_FRAME_7_DAYS",
            "id": "{{id}}",
            "requestBasedMetricSli": {
              "goodEvents": {
                "query": "sum(rate(http_requests_total{status=\"200\"}[1m])) by (service)"
              },
              "totalEvents": {
                "query": "sum(rate(http_requests_total[1m])) by (service)"
              }
            }
          }
        },
        {
          "method": "GET",
          "path": "/{{id}}"
        },
        {
          "method": "DELETE",
          "path": "/{{id}}"
        },
        {
          "method": "GET",
          "path": "/{{id}}"
        }
      ]
    },
    {
      "name": "window based: missing data strategy omitted, set, then omitted on replace",
      "steps": [
        {
          "method": "POST",
          "path": "",
          "capture": "id",
          "body": {
            "name": "tf-fidelity-window",
            "targetThresholdPercentage": 99.5,
            "sloTimeFrame": "SLO_TIME_FRAME_7_DAYS",
