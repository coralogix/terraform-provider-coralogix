              "query": {
                "query": "sum(rate(up[1m])) by (job)"
              },
              "window": "WINDOW_SLO_WINDOW_1_MINUTE",
              "comparisonOperator": "COMPARISON_OPERATOR_GREATER_THAN",
              "threshold": 0.5
