{
  "comment": "Live API requests used to validate the teams fake. Every team that a case creates has a name that starts with the run name, and the recorder deletes only those. {{A}} and the other capitals are the ids that an earlier Create returned. 4294967295 is an id that no team has. Quotas between 0.01 and 0.02 read back inconsistently on the real API, so no case uses one.",
  "cases": [
    {
      "name": "lifecycle",
      "steps": [
        {"method": "POST", "path": "", "body": {"teamName": "{{NAME}}-a", "dailyQuota": 0.5}, "capture": "A"},
        {"method": "GET", "path": "/{{A}}"},
        {"method": "PUT", "path": "/{{A}}", "body": {"teamName": "{{NAME}}-a2"}},
        {"method": "GET", "path": "/{{A}}"},
        {"method": "PUT", "path": "/{{A}}", "body": {"dailyQuota": 0.3}},
        {"method": "GET", "path": "/{{A}}"},
        {"method": "PUT", "path": "/{{A}}", "body": {}},
        {"method": "GET", "path": "/{{A}}"},
        {"method": "PUT", "path": "/{{A}}", "body": {"teamName": "{{NAME}}-a2", "dailyQuota": 0.1234567}},
        {"method": "GET", "path": "/{{A}}"},
        {"method": "PUT", "path": "/{{A}}", "body": {"dailyQuota": 0}},
        {"method": "PUT", "path": "/{{A}}", "body": {"dailyQuota": -1}},
        {"method": "PUT", "path": "/{{A}}", "body": {"teamName": ""}},
        {"method": "DELETE", "path": "/{{A}}"},
        {"method": "GET", "path": "/{{A}}"},
        {"method": "PUT", "path": "/{{A}}", "body": {"dailyQuota": 0.5}},
        {"method": "DELETE", "path": "/{{A}}"}
      ]
    },
    {
      "name": "create-quota",
      "steps": [
        {"method": "POST", "path": "", "body": {"teamName": "{{NAME}}-b"}, "capture": "B"},
        {"method": "GET", "path": "/{{B}}"},
        {"method": "POST", "path": "", "body": {"teamName": "{{NAME}}-c", "dailyQuota": 0.005}, "capture": "C"},
        {"method": "GET", "path": "/{{C}}"},
        {"method": "POST", "path": "", "body": {"teamName": "{{NAME}}-d", "dailyQuota": 0}, "capture": "D"},
        {"method": "GET", "path": "/{{D}}"},
        {"method": "POST", "path": "", "body": {"teamName": "{{NAME}}-e", "dailyQuota": 0.1234567}, "capture": "E"},
        {"method": "GET", "path": "/{{E}}"},
        {"method": "DELETE", "path": "/{{B}}"},
        {"method": "PUT", "path": "/{{B}}", "body": {"dailyQuota": 0.5}},
        {"method": "DELETE", "path": "/{{B}}"},
        {"method": "PUT", "path": "/{{C}}", "body": {"dailyQuota": 0.5}},
        {"method": "DELETE", "path": "/{{C}}"},
        {"method": "PUT", "path": "/{{D}}", "body": {"dailyQuota": 0.5}},
        {"method": "DELETE", "path": "/{{D}}"},
        {"method": "DELETE", "path": "/{{E}}"}
      ]
    },
    {
      "name": "names",
      "steps": [
        {"method": "POST", "path": "", "body": {"teamName": "{{NAME}}-f", "dailyQuota": 0.5}, "capture": "F"},
        {"method": "POST", "path": "", "body": {"teamName": "{{NAME}}-f", "dailyQuota": 0.5}},
        {"method": "POST", "path": "", "body": {"teamName": "", "dailyQuota": 0.5}},
        {"method": "POST", "path": "", "body": {}},
        {"method": "POST", "path": "", "body": {"teamName": "{{NAME}}-g", "dailyQuota": 0.5}, "capture": "G"},
        {"method": "PUT", "path": "/{{G}}", "body": {"teamName": "{{NAME}}-f"}},
        {"method": "PUT", "path": "/{{G}}", "body": {"teamName": "{{NAME}}-g"}},
        {"method": "GET", "path": "/{{G}}"},
        {"method": "DELETE", "path": "/{{F}}"},
        {"method": "DELETE", "path": "/{{G}}"}
      ]
    },
    {
      "name": "missing",
      "steps": [
        {"method": "GET", "path": "/4294967295"},
        {"method": "PUT", "path": "/4294967295", "body": {"dailyQuota": 0.5}},
        {"method": "DELETE", "path": "/4294967295"},
        {"method": "GET", "path": "/not-a-number"}
      ]
    }
  ]
}
