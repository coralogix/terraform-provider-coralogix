    "logs_filter": {
     "simple_filter": {
      "label_filters": {
       "application_name": [
        {
         "operation": "IS",
         "value": "app-a"
        },
        {
         "operation": "STARTS_WITH",
         "value": "app-"
        }
       ],
       "severities": [
        "Warning",
        "Error"
       ],
       "subsystem_name": [
        {
         "operation": "ENDS_WITH",
         "value": "-sub"
        },
        {
         "operation": "INCLUDES",
         "value": "ub"
        }
       ]
      },
      "lucene_query": "message:\"tfbaseline\""
     }
    },
    "notification_payload_filter": [
     "coralogix.metadata.sdkId",
     "coralogix.metadata.sdkName"
    ],
    "percentage_of_deviation": 15.5,
    "rules": [
     {
      "condition": {
       "minimum_threshold": 5,
       "time_window": "10_MINUTES"
