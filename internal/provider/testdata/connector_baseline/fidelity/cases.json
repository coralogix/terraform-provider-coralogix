{
  "comment": "Requests that a recorder sends to the real backend, and the offline test sends to the fake. Tokens: {{RUN}} run id, {{C1}}..{{C5}} connector ids, {{GEN}} an id that the server made (set by 'capture').",
  "cases": [
    {
      "name": "minimal-lifecycle",
      "steps": [
        {"method": "POST", "path": "", "body": {"connector": {"id": "{{C1}}", "name": "{{C1}}", "type": "GENERIC_HTTPS", "connectorConfig": {"fields": [{"fieldName": "url", "value": "https://example.com"}]}}}},
        {"method": "GET", "path": "/{{C1}}"},
        {"method": "PUT", "path": "", "body": {"connector": {"id": "{{C1}}", "name": "renamed", "type": "GENERIC_HTTPS", "connectorConfig": {"fields": [{"fieldName": "url", "value": "https://example.com"}]}}}},
        {"method": "GET", "path": "/{{C1}}"},
        {"method": "DELETE", "path": "/{{C1}}"},
        {"method": "GET", "path": "/{{C1}}"},
        {"method": "DELETE", "path": "/{{C1}}"}
      ]
    },
    {
      "name": "description-and-config-overrides",
      "steps": [
        {"method": "POST", "path": "", "body": {"connector": {"id": "{{C2}}", "name": "{{C2}}", "type": "SLACK"}}},
        {"method": "GET", "path": "/{{C2}}"},
        {"method": "PUT", "path": "", "body": {"connector": {"id": "{{C2}}", "name": "{{C2}}", "type": "SLACK", "description": "d", "configOverrides": [{"entityType": "ALERTS", "fields": [{"fieldName": "channel", "template": "#ops"}]}]}}},
        {"method": "GET", "path": "/{{C2}}"},
        {"method": "PUT", "path": "", "body": {"connector": {"id": "{{C2}}", "name": "{{C2}}", "type": "SLACK"}}},
        {"method": "GET", "path": "/{{C2}}"},
        {"method": "PUT", "path": "", "body": {"connector": {"id": "{{C2}}", "name": "{{C2}}", "type": "SLACK", "description": "", "configOverrides": []}}},
        {"method": "GET", "path": "/{{C2}}"}
      ]
    },
    {
      "name": "fields-set",
      "steps": [
        {"method": "POST", "path": "", "body": {"connector": {"id": "{{C3}}", "name": "{{C3}}", "type": "GENERIC_HTTPS", "connectorConfig": {"fields": [{"fieldName": "method", "value": "post"}, {"fieldName": "url", "value": "https://example.com/hook"}]}}}},
        {"method": "GET", "path": "/{{C3}}"}
      ]
    },
    {
      "name": "validation",
      "steps": [
        {"method": "POST", "path": "", "body": {}},
        {"method": "POST", "path": "", "body": {"connector": {}}},
        {"method": "POST", "path": "", "body": {"connector": {"id": "{{C4}}", "name": "", "type": "SLACK"}}},
        {"method": "POST", "path": "", "body": {"connector": {"id": "{{C4}}", "name": "{{C4}}"}}},
        {"method": "POST", "path": "", "body": {"connector": {"id": "{{C4}}", "name": "{{C4}}", "type": "NOT_AN_ENUM"}}},
        {"method": "PUT", "path": "", "body": {"connector": {"name": "no id", "type": "SLACK"}}},
        {"method": "GET", "path": "/missing"},
        {"method": "DELETE", "path": "/missing"}
      ]
    },
    {
      "name": "duplicate-id-and-generated-id",
      "steps": [
        {"method": "POST", "path": "", "body": {"connector": {"id": "{{C5}}", "name": "{{C5}}", "type": "EMAIL"}}},
        {"method": "POST", "path": "", "body": {"connector": {"id": "{{C5}}", "name": "{{C5}}", "type": "EMAIL"}}},
        {"method": "POST", "path": "", "capture": "GEN", "body": {"connector": {"name": "generated", "type": "EMAIL"}}},
        {"method": "GET", "path": "/{{GEN}}"}
      ]
    }
  ]
}
